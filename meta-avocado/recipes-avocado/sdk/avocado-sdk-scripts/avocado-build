#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Get the directory where this script is located
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Source the common functions
source "${SCRIPT_DIR}/avocado-sdk-common.sh"

# Define the main function that will run in the SDK environment
build_extension() {
    # Common variables
    EXT_NAME="$2"
    EXT_VERSION="0.1.0"
    EXT_ID="avocado"
    OUTPUT_DIR="${AVOCADO_PREFIX}/extensions"
    OUTPUT_FILE=""
    IMAGES_DIR="${AVOCADO_PREFIX}/images"
    DEPLOY_DIR="${IMAGES_DIR}/deploy"
    OUTPUT_PATH="${AVOCADO_PREFIX}/output"

    # Function to create extension release file
    create_extension_release() {
        local release_dir="$1"
        local release_file="$release_dir/extension-release.$EXT_NAME"
        
        mkdir -p "$release_dir"
        echo "ID=$EXT_ID" > "$release_file"
        echo "VERSION_ID=$EXT_VERSION" >> "$release_file"
        echo "EXTENSION_RELOAD_MANAGER=1" >> "$release_file"
    }

    # Function to convert value to bytes based on unit
    convert_unit_to_bytes() {
        local value=$1
        local unit=$2

        case "$unit" in
            "bytes")
                echo $((value))
                ;;
            "kibibytes")
                echo $((value * 1024))
                ;;
            "mebibytes")
                echo $((value * 1024 * 1024))
                ;;
            *)
                echo "Error: unsupported unit: $unit" >&2
                return 1
                ;;
        esac
    }

    if [ "$1" = "sysext" ]; then
        echo "Building system extension: $EXT_NAME"
        OUTPUT_FILE="${OUTPUT_DIR}/sysext/${EXT_NAME}.raw"
        mkdir -p "${OUTPUT_DIR}/sysext"
        rm -f "$OUTPUT_FILE"
        create_extension_release "$AVOCADO_PREFIX/sysext/usr/lib/extension-release.d"

        # Check if sysext directory exists
        if [ ! -d "$AVOCADO_PREFIX/sysext" ]; then
            echo "Error: sysext directory does not exist in sysroot"
            exit 1
        fi

        mksquashfs "$AVOCADO_PREFIX/sysext" "$OUTPUT_FILE" -noappend
        
    elif [ "$1" = "confext" ]; then
        echo "Building configuration extension: $EXT_NAME"
        OUTPUT_FILE="${OUTPUT_DIR}/confext/${EXT_NAME}.raw"
        mkdir -p "${OUTPUT_DIR}/confext"
        rm -f "$OUTPUT_FILE"
        create_extension_release "$AVOCADO_PREFIX/confext/etc/extension-release.d"

        # Check if confext directory exists
        if [ ! -d "$AVOCADO_PREFIX/confext" ]; then
            echo "Error: confext directory does not exist in sysroot"
            exit 1
        fi

        mksquashfs "$AVOCADO_PREFIX/confext" "$OUTPUT_FILE" -noappend
        
    elif [ "$1" = "var" ]; then
        echo "Building var image"
        mkdir -p "$IMAGES_DIR"
        
        # Create var sysroot structure
        echo "Creating var sysroot structure..."
        mkdir -p "$AVOCADO_PREFIX/var/lib/extensions"
        mkdir -p "$AVOCADO_PREFIX/var/lib/confexts"
        
        # Copy existing extensions into var sysroot if they exist
        echo "Copying system extensions..."
        if ls "${OUTPUT_DIR}/sysext/"*.raw 1> /dev/null 2>&1; then
            cp -f "${OUTPUT_DIR}/sysext/"*.raw "$AVOCADO_PREFIX/var/lib/extensions/"
        else
            echo "No system extensions found, skipping..."
        fi

        echo "Copying configuration extensions..."
        if ls "${OUTPUT_DIR}/confext/"*.raw 1> /dev/null 2>&1; then
            cp -f "${OUTPUT_DIR}/confext/"*.raw "$AVOCADO_PREFIX/var/lib/confexts/"
        else
            echo "No configuration extensions found, skipping..."
        fi
        
        # Create btrfs image with extensions and confexts subvolumes
        mkfs.btrfs -r "$AVOCADO_PREFIX/var" \
            --subvol rw:lib/extensions \
            --subvol rw:lib/confexts \
            -f "${IMAGES_DIR}/avocado-image-var.btrfs"

    elif [ "$1" = "image" ]; then
        echo "Building complete system image"
        mkdir -p "$IMAGES_DIR"
        mkdir -p "$DEPLOY_DIR"
        mkdir -p "$OUTPUT_PATH"

        # First build the var image if it doesn't exist
        if [ ! -f "${IMAGES_DIR}/avocado-image-var.btrfs" ]; then
            echo "Building var image first..."
            build_extension "var" "$EXT_NAME"
        fi

        # Copy var image to deploy directory
        cp "${IMAGES_DIR}/avocado-image-var.btrfs" "${DEPLOY_DIR}/avocado-image-var-avocado-${AVOCADO_SDK_TARGET}.var.img"

        stone_manifest="${AVOCADO_SDK_PREFIX}/stone/stone-${AVOCADO_SDK_TARGET}.json"
        rootdisk_config=$(cat "${stone_manifest}" | jq .storage_devices.rootdisk)
        images_config=$(echo "${rootdisk_config}" | jq .images)
        architecture=$(cat "${stone_manifest}" | jq -r .runtime.architecture)
        disk_uuid=$(echo "${rootdisk_config}" | jq -r .uuid)
        boot_config=$(echo "${images_config}" | jq .boot) 
        boot_size=$(echo "${boot_config}" | jq -r .size)
        boot_image_file=$(echo "${boot_config}" | jq -r .out)
        echo "${boot_config}" | mkfat -b "${DEPLOY_DIR}" -s "${boot_size}" -o "${DEPLOY_DIR}/${boot_image_file}"

        partitions_config=$(echo "${rootdisk_config}" | jq .partitions)
        uboot_env_partition=$(echo "${partitions_config}" | jq -r '.[] | select(.name == "uboot-env")')
        boot_a_partition=$(echo "${partitions_config}" | jq -r '.[] | select(.name == "boot-a")')
        boot_b_partition=$(echo "${partitions_config}" | jq -r '.[] | select(.name == "boot-b")')
        rootfs_a_partition=$(echo "${partitions_config}" | jq -r '.[] | select(.name == "rootfs-a")')
        rootfs_b_partition=$(echo "${partitions_config}" | jq -r '.[] | select(.name == "rootfs-b")')
        var_partition=$(echo "${partitions_config}" | jq -r '.[] | select(.name == "var")')

        block_size=$(echo "${rootdisk_config}" | jq -r .block_size)
        uboot_env_offset_val=$(echo "${uboot_env_partition}" | jq -r .offset)
        uboot_env_offset_unit=$(echo "${uboot_env_partition}" | jq -r .offset_unit)
        offset_in_bytes=$(convert_unit_to_bytes "$uboot_env_offset_val" "$uboot_env_offset_unit")
        uboot_env_offset_blocks=$((offset_in_bytes / block_size))

        uboot_env_offset_redund_val=$(echo "${uboot_env_partition}" | jq -r .offset_redundant)
        uboot_env_offset_redund_unit=$(echo "${uboot_env_partition}" | jq -r .offset_redundant_unit)
        offset_redund_in_bytes=$(convert_unit_to_bytes "$uboot_env_offset_redund_val" "$uboot_env_offset_redund_unit")
        uboot_env_offset_redund_blocks=$((offset_redund_in_bytes / block_size))

        uboot_env_size_val=$(echo "${uboot_env_partition}" | jq -r .size)
        uboot_env_size_unit=$(echo "${uboot_env_partition}" | jq -r .size_unit)
        size_in_bytes=$(convert_unit_to_bytes "$uboot_env_size_val" "$uboot_env_size_unit")
        uboot_env_size_blocks=$((size_in_bytes / block_size))
        
        uboot_env_image_name=$(echo "${uboot_env_partition}" | jq -r .image)
        uboot_env_image_file=$(echo "${images_config}" | jq -r --arg key "${uboot_env_image_name}" '.[$key] | if type=="object" then .out else . end')

        rootfs_a_image_name=$(echo "${rootfs_a_partition}" | jq -r .image)
        rootfs_a_image_file=$(echo "${images_config}" | jq -r --arg key "${rootfs_a_image_name}" '.[$key] | if type=="object" then .out else . end')
        var_image_name=$(echo "${var_partition}" | jq -r .image)
        var_image_file=$(echo "${images_config}" | jq -r --arg key "${var_image_name}" '.[$key] | if type=="object" then .out else . end')

        boot_a_offset_val=$(echo "${boot_a_partition}" | jq -r .offset)
        boot_a_offset_unit=$(echo "${boot_a_partition}" | jq -r .offset_unit)
        boot_a_offset_in_bytes=$(convert_unit_to_bytes "$boot_a_offset_val" "$boot_a_offset_unit")
        boot_a_offset_blocks=$((boot_a_offset_in_bytes / block_size))

        boot_a_size_val=$(echo "${boot_a_partition}" | jq -r .size)
        boot_a_size_unit=$(echo "${boot_a_partition}" | jq -r .size_unit)
        boot_a_size_in_bytes=$(convert_unit_to_bytes "$boot_a_size_val" "$boot_a_size_unit")
        boot_a_size_blocks=$((boot_a_size_in_bytes / block_size))

        boot_b_offset_val=$(echo "${boot_b_partition}" | jq -r .offset)
        if [ -z "$boot_b_offset_val" ] || [ "$boot_b_offset_val" = "null" ]; then
            boot_b_offset_blocks=$((boot_a_offset_blocks + boot_a_size_blocks))
        else
            boot_b_offset_unit=$(echo "${boot_b_partition}" | jq -r .offset_unit)
            boot_b_offset_in_bytes=$(convert_unit_to_bytes "$boot_b_offset_val" "$boot_b_offset_unit")
            boot_b_offset_blocks=$((boot_b_offset_in_bytes / block_size))
        fi

        boot_b_size_val=$(echo "${boot_b_partition}" | jq -r .size)
        boot_b_size_unit=$(echo "${boot_b_partition}" | jq -r .size_unit)
        boot_b_size_in_bytes=$(convert_unit_to_bytes "$boot_b_size_val" "$boot_b_size_unit")
        boot_b_size_blocks=$((boot_b_size_in_bytes / block_size))

        recovery_partition=$(echo "${partitions_config}" | jq -r '.[] | select(.name == "recovery")')
        recovery_offset_val=$(echo "${recovery_partition}" | jq -r .offset)
        if [ -z "$recovery_offset_val" ] || [ "$recovery_offset_val" = "null" ]; then
            recovery_offset_blocks=$((boot_b_offset_blocks + boot_b_size_blocks))
        else
            recovery_offset_unit=$(echo "${recovery_partition}" | jq -r .offset_unit)
            recovery_offset_in_bytes=$(convert_unit_to_bytes "$recovery_offset_val" "$recovery_offset_unit")
            recovery_offset_blocks=$((recovery_offset_in_bytes / block_size))
        fi

        recovery_size_val=$(echo "${recovery_partition}" | jq -r .size)
        recovery_size_unit=$(echo "${recovery_partition}" | jq -r .size_unit)
        recovery_size_in_bytes=$(convert_unit_to_bytes "$recovery_size_val" "$recovery_size_unit")
        recovery_size_blocks=$((recovery_size_in_bytes / block_size))

        rootfs_a_offset_val=$(echo "${rootfs_a_partition}" | jq -r .offset)
        if [ -z "$rootfs_a_offset_val" ] || [ "$rootfs_a_offset_val" = "null" ]; then
            rootfs_a_offset_blocks=$((recovery_offset_blocks + recovery_size_blocks))
        else
            rootfs_a_offset_unit=$(echo "${rootfs_a_partition}" | jq -r .offset_unit)
            rootfs_a_offset_in_bytes=$(convert_unit_to_bytes "$rootfs_a_offset_val" "$rootfs_a_offset_unit")
            rootfs_a_offset_blocks=$((rootfs_a_offset_in_bytes / block_size))
        fi

        rootfs_a_size_val=$(echo "${rootfs_a_partition}" | jq -r .size)
        rootfs_a_size_unit=$(echo "${rootfs_a_partition}" | jq -r .size_unit)
        rootfs_a_size_in_bytes=$(convert_unit_to_bytes "$rootfs_a_size_val" "$rootfs_a_size_unit")
        rootfs_a_size_blocks=$((rootfs_a_size_in_bytes / block_size))

        rootfs_b_offset_val=$(echo "${rootfs_b_partition}" | jq -r .offset)
        if [ -z "$rootfs_b_offset_val" ] || [ "$rootfs_b_offset_val" = "null" ]; then
            rootfs_b_offset_blocks=$((rootfs_a_offset_blocks + rootfs_a_size_blocks))
        else
            rootfs_b_offset_unit=$(echo "${rootfs_b_partition}" | jq -r .offset_unit)
            rootfs_b_offset_in_bytes=$(convert_unit_to_bytes "$rootfs_b_offset_val" "$rootfs_b_offset_unit")
            rootfs_b_offset_blocks=$((rootfs_b_offset_in_bytes / block_size))
        fi

        rootfs_b_size_val=$(echo "${rootfs_b_partition}" | jq -r .size)
        rootfs_b_size_unit=$(echo "${rootfs_b_partition}" | jq -r .size_unit)
        rootfs_b_size_in_bytes=$(convert_unit_to_bytes "$rootfs_b_size_val" "$rootfs_b_size_unit")
        rootfs_b_size_blocks=$((rootfs_b_size_in_bytes / block_size))

        var_offset_val=$(echo "${var_partition}" | jq -r .offset)
        if [ -z "$var_offset_val" ] || [ "$var_offset_val" = "null" ]; then
            var_offset_blocks=$((rootfs_b_offset_blocks + rootfs_b_size_blocks))
        else
            var_offset_unit=$(echo "${var_partition}" | jq -r .offset_unit)
            var_offset_in_bytes=$(convert_unit_to_bytes "$var_offset_val" "$var_offset_unit")
            var_offset_blocks=$((var_offset_in_bytes / block_size))
        fi

        var_size_val=$(echo "${var_partition}" | jq -r .size)
        var_size_unit=$(echo "${var_partition}" | jq -r .size_unit)
        var_size_in_bytes=$(convert_unit_to_bytes "$var_size_val" "$var_size_unit")
        var_size_blocks=$((var_size_in_bytes / block_size))

        AVOCADO_OS_VERSION_FINAL="${AVOCADO_OS_VERSION}"
        if [ -z "${AVOCADO_OS_VERSION_FINAL}" ] && [ -f /etc/os-release ]; then
            AVOCADO_OS_VERSION_FINAL=$(grep '^VERSION_ID=' /etc/os-release | cut -d'=' -f2 | tr -d '"')
        fi

        AVOCADO_SDK_RUNTIME_DIR="${DEPLOY_DIR}" \
        AVOCADO_IMAGE_UBOOT_ENV="${uboot_env_image_file}" \
        AVOCADO_IMAGE_BOOT="${boot_image_file}" \
        AVOCADO_IMAGE_ROOTFS="${rootfs_a_image_file}" \
        AVOCADO_IMAGE_VAR="${var_image_file}" \
        AVOCADO_OS_CODENAME="${AVOCADO_SDK_REPO_RELEASE}" \
        AVOCADO_OS_DESCRIPTION="Avocado ${AVOCADO_SDK_REPO_RELEASE}" \
        AVOCADO_OS_VERSION="${AVOCADO_OS_VERSION_FINAL}" \
        AVOCADO_OS_PLATFORM="${AVOCADO_SDK_TARGET}" \
        AVOCADO_OS_ARCHITECTURE="${architecture}" \
        AVOCADO_OS_AUTHOR="Avocado Linux" \
        AVOCADO_DISK_UUID="${disk_uuid}" \
        AVOCADO_PARTITION_UBOOT_ENV_OFFSET=${uboot_env_offset_blocks} \
        AVOCADO_PARTITION_UBOOT_ENV_OFFSET_REDUND=${uboot_env_offset_redund_blocks} \
        AVOCADO_PARTITION_UBOOT_ENV_BLOCKS=${uboot_env_size_blocks} \
        AVOCADO_PARTITION_BOOTFS_A_OFFSET=${boot_a_offset_blocks} \
        AVOCADO_PARTITION_BOOTFS_A_BLOCKS=${boot_a_size_blocks} \
        AVOCADO_PARTITION_BOOTFS_B_OFFSET=${boot_b_offset_blocks} \
        AVOCADO_PARTITION_BOOTFS_B_BLOCKS=${boot_b_size_blocks} \
        AVOCADO_PARTITION_RECOVERY_OFFSET=${recovery_offset_blocks} \
        AVOCADO_PARTITION_RECOVERY_BLOCKS=${recovery_size_blocks} \
        AVOCADO_PARTITION_ROOTFS_A_OFFSET=${rootfs_a_offset_blocks} \
        AVOCADO_PARTITION_ROOTFS_A_BLOCKS=${rootfs_a_size_blocks} \
        AVOCADO_PARTITION_ROOTFS_B_OFFSET=${rootfs_b_offset_blocks} \
        AVOCADO_PARTITION_ROOTFS_B_BLOCKS=${rootfs_b_size_blocks} \
        AVOCADO_PARTITION_VAR_OFFSET=${var_offset_blocks} \
        AVOCADO_PARTITION_VAR_BLOCKS=${var_size_blocks} \
        fwup -c -f "${AVOCADO_SDK_PREFIX}/stone/${AVOCADO_SDK_TARGET}/rootdisk.conf" -o "${DEPLOY_DIR}/${AVOCADO_SDK_TARGET}-rootdisk.zip"
        fwup -a -d "${DEPLOY_DIR}/${AVOCADO_SDK_TARGET}-rootdisk.img" -i "${DEPLOY_DIR}/${AVOCADO_SDK_TARGET}-rootdisk.zip" -t complete
        echo "System image created $OUTPUT_PATH" "${DEPLOY_DIR}/${AVOCADO_SDK_TARGET}-rootdisk.img"
        
    else
        echo "Usage: $0 [sysext|confext|var|image] <name>"
        exit 1
    fi
}

# Run the main function in the SDK environment
run_in_sdk_env build_extension "$@"

