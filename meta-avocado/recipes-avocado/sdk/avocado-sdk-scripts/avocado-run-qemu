#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Get the directory where this script is located
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
IMAGES_DIR="${AVOCADO_PREFIX}/images"
DEPLOY_DIR="${IMAGES_DIR}"

# Source the common functions
source "avocado-sdk-common.sh"

# Define the main function that will run in the SDK environment
run_qemu() {
    # Check if this is a QEMU target
    if [[ ! "$AVOCADO_SDK_TARGET" =~ qemu ]]; then
        echo "Error: This script can only be run for QEMU targets"
        echo "Current target: $AVOCADO_SDK_TARGET"
        exit 1
    fi

    IMAGE_FILE="${DEPLOY_DIR}/${AVOCADO_SDK_TARGET}-rootdisk.img"
    if [ ! -f "$IMAGE_FILE" ]; then
        echo "Error: Image file not found: $IMAGE_FILE"
        echo "Please build the image first using: avocado-build image"
        exit 1
    fi

    qemu-img resize -f raw "${IMAGE_FILE}" 1024M

    if [[ "$AVOCADO_SDK_TARGET" == "qemux86-64" ]]; then
        QEMU_SYSTEM="qemu-system-x86_64"
        QEMU_BIOS="${IMAGES_DIR}/deploy/u-boot.rom"
        CPU_TYPE="max"
        QEMU_OPTS=()
    elif [[ "$AVOCADO_SDK_TARGET" == "qemuarm64" ]]; then
        QEMU_SYSTEM="qemu-system-aarch64"
        QEMU_BIOS="${IMAGES_DIR}/deploy/flash.bin"
        CPU_TYPE="cortex-a53"
        QEMU_OPTS=("-M" "virt,secure=on,highmem=off")
    else
        echo "Error: Unsupported QEMU target: $AVOCADO_SDK_TARGET"
        exit 1
    fi

    if [ ! -f "$QEMU_BIOS" ]; then
        echo "Error: BIOS file not found: $QEMU_BIOS"
        exit 1
    fi

    "${QEMU_SYSTEM}" \
        -bios "${QEMU_BIOS}" \
        -device sdhci-pci \
        -device sd-card,drive=mmc \
        -drive file="${IMAGE_FILE}",if=none,format=raw,id=mmc \
        -m 1024 \
        -cpu "${CPU_TYPE}" \
        "${QEMU_OPTS[@]}" \
        -nographic
}

# Run the main function in the SDK environment
run_in_sdk_env run_qemu "$@"
