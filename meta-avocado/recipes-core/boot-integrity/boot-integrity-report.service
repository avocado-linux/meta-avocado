[Unit]
Description=Publish boot-integrity state (enforcement and root of trust)
# Wants, not Requires, and both are needed. After= alone orders against a unit
# nothing pulls in, so on this image - whose systemd is built without EFI
# support and so mounts efivarfs itself - the report ran before anything had
# mounted it and read an empty directory.
#
# Requires= would be wrong in the other direction: on a target with no efivarfs
# the mount cannot start, and this service must still run and report that. "No
# efivarfs" is a fact the record exists to carry, so a dependency that suppressed
# the run would hide exactly the case worth reporting.
Wants=sys-firmware-efi-efivars.mount
After=sys-firmware-efi-efivars.mount local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/boot-integrity/boot-integrity-report.sh
# The record lives in /run and is rebuilt every boot, so it must not be
# forgotten the moment the unit exits.
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
