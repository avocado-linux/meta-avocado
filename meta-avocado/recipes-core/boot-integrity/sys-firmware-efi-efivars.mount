[Unit]
Description=EFI Variable File System
Documentation=https://www.kernel.org/doc/Documentation/filesystems/efivarfs.rst
# systemd normally mounts efivarfs itself, from PID 1, when it detects an EFI
# boot. This image's systemd is built WITHOUT EFI support - its feature list
# carries no +EFI - so is_efi_boot() is compiled out and that mount never
# happens. The kernel and the firmware are both fine: efivarfs is in
# /proc/filesystems, and mounting it by hand exposes 13 variables including
# SecureBoot. What was missing was only the mount.
#
# The failure that costs time is what it looks like from userspace:
# /sys/firmware/efi/efivars exists as a bare mount point, so an empty directory
# reads as "firmware exposes no variables" when the truth is "nothing mounted
# it". The reporter distinguishes the two now; this unit removes the case.
#
# devtool-debt: this duplicates a unit systemd ships under the same name, and
# two packages owning one path is a build error, not a silent override.
# Ceiling: correct only while systemd is built without EFI support, which is
# what makes the name unclaimed today.
# Upgrade trigger: the systemd recipe gains 'efi' in PACKAGECONFIG - at which
# point delete this file and let systemd's own unit do the work.
DefaultDependencies=no
# The mount POINT, not the filesystem: this is what the kernel creates on an EFI
# boot, and its absence is exactly the case where mounting must not be attempted.
ConditionPathExists=/sys/firmware/efi/efivars
ConditionPathIsReadWrite=/sys
Before=sysinit.target

[Mount]
What=efivarfs
Where=/sys/firmware/efi/efivars
Type=efivarfs
# systemd's own options for this mount. Not read-only: the mount carries no
# security property worth protecting here - the PoC keeps these variables in a
# file on a FAT partition, so root could rewrite them through the boot medium
# whether or not this mount exists.
Options=nosuid,nodev,noexec

[Install]
WantedBy=sysinit.target
