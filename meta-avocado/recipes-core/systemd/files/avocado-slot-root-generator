#!/bin/sh
# systemd generator: mount /sysroot from the rootfs slot that matches the ESP
# the firmware actually booted.
#
# WHY THIS EXISTS. stone's OTA schema gives each update.os_artifacts entry a
# single image_key shared by every slot in slot_partitions, so one build of the
# 'boot' image is delivered byte-identical to whichever ESP an update targets.
# No string inside that image can differ per slot, which means the loader entry
# cannot carry a per-slot root= no matter how it is written - both ESPs end up
# holding the same bytes. With a static root=PARTLABEL=rootfs-a an A->B update
# boots B's kernel against A's rootfs: the update reports success while the old
# rootfs is still the one running.
#
# The one thing that does differ per slot at runtime is which ESP the firmware
# booted from. systemd-boot publishes it in the LoaderDevicePartUUID EFI
# variable (systemd Boot Loader Interface, vendor GUID
# 4a67b082-0a4c-41cf-b6c7-440b29bb8c4f). Resolving that against a table built
# from the same stone manifest that assigns those ESP partition UUIDs lets one
# identical boot image reach the right rootfs from either slot.
#
# This only retargets the mount. systemd-fstab-generator still builds
# sysroot.mount from the kernel command line; the drop-in written below
# replaces What= and nothing else. Every path that cannot determine a slot
# leaves the command-line value standing, so the worst case is the behaviour
# that ships today rather than a board that will not boot.
set -eu

SELF=avocado-slot-root-generator
EFI_VAR=/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
SLOT_MAP=/usr/lib/avocado/slot-root-map

# syslog is not available to a generator, so /dev/kmsg is the channel a message
# can actually reach this early (systemd.generator(7), "NOTES ABOUT WRITING
# GENERATORS"). stderr is kept as well: it lands in the journal once that is up,
# and it is all that is left if /dev/kmsg is not writable.
log() {
  echo "$SELF: $*" >&2
  if [ -w /dev/kmsg ]; then
    echo "$SELF: $*" >/dev/kmsg
  fi
}

# argv[2] is the early generator directory. It is the only output directory
# whose drop-ins outrank the sysroot.mount systemd-fstab-generator writes into
# argv[1] (systemd.generator(7), "OUTPUT DIRECTORIES").
dest_early="${2:-}"
[ -n "$dest_early" ] || exit 0

# sysroot.mount exists only while the initrd is in charge; on the real root
# there is nothing to retarget. /etc/initrd-release is the long-standing initrd
# marker and predates $SYSTEMD_IN_INITRD (systemd v251), so accept either.
if [ "${SYSTEMD_IN_INITRD:-}" != "1" ] && [ ! -f /etc/initrd-release ]; then
  exit 0
fi

if [ ! -f "$SLOT_MAP" ]; then
  log "no slot map at $SLOT_MAP; keeping the kernel command-line root="
  exit 0
fi

# Absent on a non-UEFI boot, and on UEFI firmware whose loader does not
# implement the Boot Loader Interface. Neither is a reason to fail the boot.
if [ ! -r "$EFI_VAR" ]; then
  log "LoaderDevicePartUUID is unreadable; keeping the kernel command-line root="
  exit 0
fi

# efivarfs prefixes every variable with 4 bytes of EFI attributes. What follows
# is a NUL-terminated UTF-16LE string in normal GUID syntax. Every second byte
# of an ASCII UUID is NUL, so deleting NULs decodes it without iconv, which the
# initramfs does not ship. systemd-boot writes the UUID uppercase and other
# Boot Loader Interface implementations write it lowercase, so fold the case
# rather than trusting whichever one produced this boot.
esp_uuid=$(dd if="$EFI_VAR" bs=1 skip=4 2>/dev/null | tr -d '\0\n' | tr 'ABCDEF' 'abcdef')

case "$esp_uuid" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *)
    log "LoaderDevicePartUUID is not a UUID ('$esp_uuid'); keeping the kernel command-line root="
    exit 0
    ;;
esac

rootfs_part=""
while read -r map_uuid map_partition _rest; do
  case "$map_uuid" in
    '' | \#*) continue ;;
  esac
  if [ "$map_uuid" = "$esp_uuid" ]; then
    rootfs_part="$map_partition"
    break
  fi
done <"$SLOT_MAP"

# Reached when the running GPT does not match the manifest this initramfs was
# built from - a disk provisioned from an older layout, or a boot off the
# recovery ESP. Which UUID went unmatched is the whole diagnosis, so log it
# rather than guess a slot.
if [ -z "$rootfs_part" ]; then
  log "booted ESP $esp_uuid is not a known slot; keeping the kernel command-line root="
  exit 0
fi

dropin_dir="$dest_early/sysroot.mount.d"
mkdir -p "$dropin_dir"
cat >"$dropin_dir/50-avocado-slot-root.conf" <<EOF
# Generated by $SELF from $EFI_VAR.
[Mount]
What=/dev/disk/by-partlabel/$rootfs_part
EOF

log "booted ESP $esp_uuid -> /dev/disk/by-partlabel/$rootfs_part"
