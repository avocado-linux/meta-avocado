#!/bin/sh
set -e

slotsfx=""
mayberoot=""
foundslotsfx="no"
partuuid_a=""
partuuid_b=""
for bootarg in `cat /proc/cmdline`; do
    case "$bootarg" in
        boot.slot_suffix=*) slotsfx="${bootarg##boot.slot_suffix=}"; foundslotsfx="yes" ;;
        root=*) mayberoot="${bootarg##root=}" ;;
        avocado.root_partuuid=*) partuuid_a="${bootarg##avocado.root_partuuid=}" ;;
        avocado.root_partuuid_b=*) partuuid_b="${bootarg##avocado.root_partuuid_b=}" ;;
        ro) opt="ro" ;;
        rootwait) wait="yes" ;;
        rootfstype=*) fstype="${bootarg##rootfstype=}" ;;
    esac
done

rootdev=""

# Resolve the slot first, unconditionally: both the pinned-PARTUUID path and the
# PARTLABEL fallback below need it.
# Path 1: BootChainOsCurrent EFI variable (Orin / older UEFI flows).
# The 8-byte file is <attributes:4><value:4> little-endian. Attributes are
# usually 7 (NV+BS+RT) on T26x where the firmware sets NON_VOLATILE, and 6
# (BS+RT) on older T23x - accept either.
if [ "$foundslotsfx" != "yes" ]; then
    bcdata=$(echo $(hexdump -n 8 -e '2/4 " %u"' /sys/firmware/efi/efivars/BootChainOsCurrent-781e084c-a330-417c-b678-38e696380cb9 2>/dev/null) || true)
    bctype=$(echo "$bcdata" | cut -d' ' -f1)
    if [ "$bctype" = "6" ] || [ "$bctype" = "7" ]; then
        slotnum=$(echo "$bcdata" | cut -d' ' -f2)
        [ "$slotnum" != "1" ] || slotsfx="_b"
        foundslotsfx="yes"
    fi
fi

# The disk firmware booted, named by the controller behind the BootCurrent
# entry. Jetson UEFI builds a disk's boot entry as
# VenHw(...)/MemoryMapped(11,<base>,<end>)/..., and <base> is the address in
# the Linux platform device name of that controller (14160000.pcie,
# 3460000.mmc). L4TLauncher reads the kernel partitions only from the disk
# whose ESP it was started from, so this is the disk the kernel came from.
# Unlike the pin below it survives an OTA that writes a boot.img without the
# pin. Prints nothing when the entry has no MemoryMapped node (an FV boot).
EFIVARS=/sys/firmware/efi/efivars
EFI_GLOBAL=8be4df61-93ca-11d2-aa0d-00e098032b8c
# The whole variable, one hex byte per word, starting with its 4-byte
# attributes. efivarfs cannot seek, so hexdump -s fails there with "Illegal
# seek"; read from offset 0 and let the caller shift the attributes off.
efivar_bytes() {
    hexdump -v -e '1/1 "%02x "' "$EFIVARS/$1-$EFI_GLOBAL" 2>/dev/null || true
}
boot_controller() {
    # shellcheck disable=SC2046 # one byte per word
    set -- $(efivar_bytes BootCurrent)
    [ $# -eq 6 ] || return 0
    shift 4
    # shellcheck disable=SC2046
    set -- $(efivar_bytes "Boot$(echo "$2$1" | tr 'a-f' 'A-F')")
    # efivar attributes(4), then EFI_LOAD_OPTION: Attributes(4)
    # FilePathListLength(2), a NUL-terminated UCS-2 description, then the
    # device path.
    [ $# -gt 10 ] || return 0
    shift 10
    while [ $# -ge 2 ]; do
        c="$1$2"
        shift 2
        [ "$c" != "0000" ] || break
    done
    # Device path nodes: Type(1) SubType(1) Length(2, little-endian).
    while [ $# -ge 4 ]; do
        len=$((0x$4$3))
        { [ "$len" -ge 4 ] && [ "$len" -le $# ] && [ "$1" != "7f" ]; } || return 0
        if [ "$1$2" = "0103" ] && [ "$len" -eq 24 ]; then
            # MemoryMapped: MemoryType(4) StartingAddress(8) EndingAddress(8)
            (shift 8 && printf '%x\n' "$((0x$8$7$6$5$4$3$2$1))")
            return 0
        fi
        shift "$len"
    done
}
# Read on first need, in this shell: a boot with the pin present never asks.
# booted_app runs in $(...), so caching there would not survive the call.
boot_ctrl=""
boot_ctrl_read=""
boot_ctrl_init() {
    [ -z "$boot_ctrl_read" ] || return 0
    boot_ctrl=$(boot_controller)
    boot_ctrl_read=yes
}

# Prints the APP$slotsfx partition behind the booted controller, and nothing
# unless exactly one is there. Call boot_ctrl_init first.
booted_app() {
    hit=""
    [ -n "$boot_ctrl" ] || return 0
    for dev in $(blkid -t "PARTLABEL=APP$slotsfx" | cut -d: -f1); do
        phys=$(cd "/sys/class/block/${dev##*/}" 2>/dev/null && pwd -P) || continue
        case "$phys/" in
            */"$boot_ctrl".*)
                [ -z "$hit" ] || return 0
                hit="$dev"
                ;;
        esac
    done
    echo "$hit"
}

# Prints the APP$slotsfx partition that root= on the command line names, and
# nothing unless it names exactly one of them. Accepts the forms Path 3 does.
root_arg_app() {
    hit=""
    case "$mayberoot" in
        UUID=*|PARTUUID=*|PARTLABEL=*|LABEL=*)
            named=$(blkid -t "$mayberoot" | cut -d: -f1) ;;
        /dev/*)
            named="$mayberoot $(readlink -f "$mayberoot" 2>/dev/null || true)" ;;
        *) return 0 ;;
    esac
    for dev in $(blkid -t "PARTLABEL=APP$slotsfx" | cut -d: -f1); do
        for n in $named; do
            [ "$n" = "$dev" ] || continue
            [ -z "$hit" ] || return 0
            hit="$dev"
            break
        done
    done
    echo "$hit"
}

# Preferred: the rootfs PARTUUID that provisioning pinned for the medium it
# wrote, carried on the kernel command line. stone-provision-tegraflash.sh
# passes both slots because one boot.img serves A_kernel and B_kernel alike.
#
# Discovery by PARTLABEL cannot answer this question. A board with a
# provisioned SD card AND a provisioned NVMe has two partitions labelled APP,
# so the label identifies a role and not a disk, and the winner is whichever
# the kernel enumerated first - which is the SD card, because PCIe enumeration
# finishes about two seconds after the SD controller is up. Waiting longer does
# not help: once both disks are up the label is ambiguous rather than missing.
if [ "$slotsfx" = "_b" ]; then
  want_partuuid="$partuuid_b"
else
  want_partuuid="$partuuid_a"
fi

if [ -n "$want_partuuid" ]; then
  # udev lowercases GPT PARTUUIDs under /dev/disk/by-partuuid, and util-linux
  # blkid normalizes them the same way before comparing -t case-sensitively.
  # Both lookups therefore want the lowercased form, not the uppercase one the
  # layout XML carries.
  want_lower=$(echo "$want_partuuid" | tr 'A-F' 'a-f')
  printf '%s' "Waiting for rootfs PARTUUID=$want_partuuid..."
  for _ in $(seq 1 20); do
    # Cheap first: udev usually has the symlink already. readlink is not
    # allowed to abort init under set -e - busybox builds it without
    # CONFIG_FEATURE_READLINK_FOLLOW, where -f exits non-zero.
    if [ -e "/dev/disk/by-partuuid/$want_lower" ]; then
      rootdev=$(readlink -f "/dev/disk/by-partuuid/$want_lower") || rootdev=""
    fi
    if [ -z "$rootdev" ]; then
      for dev in $(lsblk -dnpo NAME); do
        blkid --probe "$dev" || true
      done
      rootdev=$(blkid -l -t "PARTUUID=$want_lower" | cut -d: -f1)
    fi
    if [ -n "$rootdev" ]; then
      echo "[OK: $rootdev]"
      break
    fi
    printf '%s' "."
    sleep 0.5
  done

  if [ -z "$rootdev" ]; then
    echo "[FAIL]"
    # Fall back to the label only when it cannot be ambiguous. One APP
    # partition means one candidate disk, so this is a board whose GPT was
    # rewritten out from under the command line - a repair flash, a manual
    # partition re-create - and refusing would strand a rootfs that is
    # plainly the right one.
    #
    # Two or more is exactly the case this path exists for. The label names
    # a role, not a disk, so picking one would be guessing between separate
    # installs - unless one of them is on the disk firmware booted from, or
    # root= on the command line names exactly one of them. Otherwise say so
    # and stop.
    boot_ctrl_init
    rootdev=$(booted_app)
    appcount=$(blkid -t "PARTLABEL=APP$slotsfx" | wc -l)
    if [ -n "$rootdev" ]; then
      echo "WARNING: PARTUUID=$want_partuuid is absent. Booting APP$slotsfx on the"
      echo "         disk firmware booted from ($boot_ctrl): $rootdev"
      echo "         Re-provision to restore the PARTUUID pin."
    elif [ "$appcount" = "1" ]; then
      rootdev=$(blkid -l -t "PARTLABEL=APP$slotsfx" | cut -d: -f1)
      echo "WARNING: PARTUUID=$want_partuuid is absent, but exactly one disk"
      echo "         carries APP$slotsfx. Booting $rootdev by label."
      echo "         Re-provision to restore the PARTUUID pin."
    else
      rootdev=$(root_arg_app)
      if [ -n "$rootdev" ]; then
        echo "WARNING: PARTUUID=$want_partuuid is absent and $appcount disks carry"
        echo "         APP$slotsfx. Booting $rootdev, the one root=$mayberoot names."
        echo "         Re-provision to restore the PARTUUID pin."
      else
        echo "Error: rootfs PARTUUID=$want_partuuid (slot '${slotsfx:-a}') never appeared,"
        echo "       and $appcount disks carry PARTLABEL=APP$slotsfx - refusing to guess."
        echo "  cmdline: $(cat /proc/cmdline)"
        blkid || true
        lsblk -o NAME,PARTLABEL,PARTUUID,SIZE || true
        exit 1
      fi
    fi
  fi
fi

# Path 2: no pin on the command line. That is a board provisioned before the
# pin existed, and also any board after an OTA has written a build-hook
# boot.img, which carries no pin. Take APP$slotsfx on the disk firmware booted
# from, and wait for it: PCIe enumerates about two seconds after the SD card.
#
# With no boot signal (an FV boot, or no efivars) there is nothing to wait
# for, so the first APP to appear ends the wait and, if it is alone at that
# moment, boots. That keeps the old race: an SD card that enumerates before
# the NVMe wins. Two or more APP disks are only caught when they are all
# present when the wait ends; then root= on the command line may name one,
# and otherwise this stops, as the pinned path does. Probe every block device
# first since blkid's label cache may be stale right after a fresh flash.
if [ -z "$rootdev" ]; then
    boot_ctrl_init
    message="Waiting for APP$slotsfx partition${boot_ctrl:+ behind $boot_ctrl}..."
    printf '%s' "$message"
    for _ in $(seq 1 20); do
        for dev in $(lsblk -dnpo NAME); do
            blkid --probe "$dev" || true
        done
        rootdev=$(booted_app)
        [ -z "$rootdev" ] || break
        # No boot signal: the first APP seen ends the wait, whether or not
        # a second disk carrying APP is still enumerating.
        if [ -z "$boot_ctrl" ] && blkid -t "PARTLABEL=APP$slotsfx" >/dev/null; then
            break
        fi
        printf '%s' "."
        sleep 0.5
    done
    appcount=$(blkid -t "PARTLABEL=APP$slotsfx" | wc -l)
    if [ -n "$rootdev" ]; then
        echo "[OK: $rootdev]"
    elif [ "$appcount" = "1" ]; then
        rootdev=$(blkid -l -t "PARTLABEL=APP$slotsfx" | cut -d: -f1)
        echo "[OK: $rootdev]"
        [ -z "$boot_ctrl" ] ||
            echo "WARNING: $rootdev is the only APP$slotsfx, and it is not behind the booted controller $boot_ctrl"
    elif [ "$appcount" -gt 1 ]; then
        rootdev=$(root_arg_app)
        if [ -n "$rootdev" ]; then
            echo "[OK: $rootdev]"
            echo "WARNING: $appcount disks carry PARTLABEL=APP$slotsfx and the boot entry"
            echo "         (controller '${boot_ctrl:-none}') names none of them. Booting"
            echo "         $rootdev, the one root=$mayberoot names."
        else
            echo "[FAIL]"
            echo "Error: $appcount disks carry PARTLABEL=APP$slotsfx and the boot entry"
            echo "       (controller '${boot_ctrl:-none}') names none of them - refusing to guess."
            echo "  cmdline: $(cat /proc/cmdline)"
            blkid || true
            lsblk -o NAME,PARTLABEL,PARTUUID,SIZE || true
            exit 1
        fi
    else
        echo "[FAIL]"
    fi
fi

# Path 3: fall back to root= from /proc/cmdline (mirrors upstream
# meta-tegra/recipes-core/initrdscripts/tegra-minimal-init/platform-preboot.sh).
if [ -z "$rootdev" ] && [ -n "$mayberoot" ]; then
    echo "[FAIL] BootChain/PARTLABEL detection failed; trying root=$mayberoot"
    case "$mayberoot" in
        UUID=*)      rootdev=$(blkid -t "UUID=${mayberoot#UUID=}" -l | awk -F: '{print $1}') ;;
        PARTUUID=*)  rootdev=$(blkid -t "PARTUUID=${mayberoot#PARTUUID=}" -l | awk -F: '{print $1}') ;;
        PARTLABEL=*) rootdev=$(blkid -t "PARTLABEL=${mayberoot#PARTLABEL=}" -l | awk -F: '{print $1}') ;;
        LABEL=*)     rootdev=$(blkid -t "LABEL=${mayberoot#LABEL=}" -l | awk -F: '{print $1}') ;;
        /dev/*)      rootdev="$mayberoot" ;;
        *)           rootdev="$mayberoot" ;;
    esac
fi

# Path 4: last-ditch scan — any disk that has an APP / APP_b PARTLABEL.
if [ -z "$rootdev" ]; then
    echo "[FAIL] root= fallback empty; scanning all disks for APP partitions"
    for label in APP APP_b; do
        cand=$(blkid -l -t "PARTLABEL=$label" | cut -d: -f1)
        if [ -n "$cand" ]; then
            rootdev="$cand"
            slotsfx="${label#APP}"
            echo "Found $label at $rootdev"
            break
        fi
    done
fi

if [ -z "$rootdev" ]; then
    echo "Error: could not locate APP rootfs partition"
    echo "  cmdline: $(cat /proc/cmdline)"
    echo "  blkid:"
    blkid || true
    echo "  lsblk:"
    lsblk -o NAME,PARTLABEL,SIZE || true
    exit 1
fi

mount "$rootdev" /sysroot

# Mount var partition by finding DATAPART_EXPAND.
# Search order: same disk as rootfs first (handles dual-install), then other disks
# (handles split layout: e.g. OS on eMMC, data on NVMe).

# Helper: scan a disk's partitions for DATAPART_EXPAND via sysfs uevent
find_datapart_on_disk() {
    local diskname="$1"
    for partdir in /sys/block/$diskname/${diskname}p*; do
        [ -d "$partdir" ] || continue
        if [ -f "$partdir/uevent" ]; then
            while IFS='=' read -r key val; do
                if [ "$key" = "PARTNAME" ] && [ "$val" = "DATAPART_EXPAND" ]; then
                    echo "/dev/$(basename "$partdir")"
                    return 0
                fi
            done < "$partdir/uevent"
        fi
    done
    return 1
}

case "$rootdev" in
  /dev/nvme*|/dev/mmc*) rootdisk="${rootdev%p*}" ;;
  /dev/sd*)             rootdisk="${rootdev%[0-9]*}" ;;
  *)                    rootdisk="" ;;
esac

vardev=""

# First: check the same disk as rootfs (preferred for single-disk installs)
if [ -n "$rootdisk" ]; then
    rootdiskname=$(basename "$rootdisk")
    echo "Looking for DATAPART_EXPAND on rootfs disk ($rootdiskname)..."
    vardev=$(find_datapart_on_disk "$rootdiskname") || true
fi

# Second: if not found on rootfs disk, search all other block devices
# This supports split layouts (e.g. OS on eMMC, data on NVMe)
if [ -z "$vardev" ]; then
    echo "DATAPART_EXPAND not on rootfs disk, scanning other disks..."
    for disk in /sys/block/*; do
        diskname=$(basename "$disk")
        # Skip non-storage devices (loop, ram, zram) and the rootfs disk
        case "$diskname" in
            loop*|ram*|zram*|mtd*) continue ;;
        esac
        [ "$diskname" = "${rootdiskname:-}" ] && continue
        vardev=$(find_datapart_on_disk "$diskname") || true
        if [ -n "$vardev" ]; then
            echo "Found DATAPART_EXPAND on $diskname"
            break
        fi
    done
fi

# Persistent fTPM: when the runtime carries optee-ftpm-init, bring up its
# store (the `reserved` partition) and tee-supplicant now, on the disk the
# rootfs came from, before the TPM2 unlock of /var below. Run here rather than
# as optee-ftpm-setup.service (masked by this recipe, like cryptsetup-var):
# only this script knows the boot disk, and the store must never come from
# another disk that also carries the label.
#
# Non-fatal, as the unit was: the setup script exits 1 when the image declares
# no ftpm capability or the kernel has no TEE, and under `set -e` that would
# stop the initrd before /var is mounted.
FTPM_SETUP=/usr/libexec/optee-ftpm/optee-ftpm-setup.sh
if [ -x "$FTPM_SETUP" ]; then
    "$FTPM_SETUP" "${rootdiskname:-}" ||
        echo "avocado-tegra-init: optee-ftpm-setup exited $?, continuing without a persistent fTPM store"
fi

# Encrypted /var: a per-runtime opt-in. avocado-cli drops the marker into the
# initramfs when avocado.yaml sets `var.encrypt`; the plaintext default has no
# marker and takes the unchanged path below. cryptsetup-var.sh (from the feed's
# cryptsetup-var package) encrypts the flashed btrfs in place on first boot and
# opens it as /dev/mapper/var afterwards. /dev/tpm0 needs no helper here:
# tpm_ftpm_tee (in the initramfs modules) binds to the firmware:ftpm device
# at coldplug. Fail closed: a marker
# without the tooling, or without a var partition, must not fall through to a
# plaintext mount.
ENC_MARKER=/etc/avocado/var-encrypt
CRYPT_SH=/usr/libexec/cryptsetup-var/cryptsetup-var.sh
if [ -e "$ENC_MARKER" ]; then
    if [ -z "$vardev" ]; then
        echo "ERROR: $ENC_MARKER set but DATAPART_EXPAND not found on any disk"
        exit 1
    fi
    if [ ! -x "$CRYPT_SH" ]; then
        echo "ERROR: $ENC_MARKER set but $CRYPT_SH is not in this initramfs"
        exit 1
    fi
    echo "Encrypted var requested: unlocking $vardev"
    "$CRYPT_SH" "$vardev"
    vardev=/dev/mapper/var
fi

if [ -n "$vardev" ]; then
    echo "Mounting var partition: $vardev"
    mount "$vardev" /sysroot/var
else
    echo "WARNING: DATAPART_EXPAND not found on any disk"
fi
