#!/bin/sh
set -e

slotsfx=""
mayberoot=""
foundslotsfx="no"
read -r cmdline < /proc/cmdline
# The command line is a whitespace-separated list, so splitting it is the point.
# mayberoot, opt, wait and fstype record arguments this script recognises but
# does not consume yet; upstream tegra-minimal-init reads them on paths we have
# not carried over.
# shellcheck disable=SC2086,SC2034
for bootarg in $cmdline; do
    case "$bootarg" in
        boot.slot_suffix=*) slotsfx="${bootarg##boot.slot_suffix=}"; foundslotsfx="yes" ;;
        root=*) mayberoot="${bootarg##root=}" ;;
        ro) opt="ro" ;;
        rootwait) wait="yes" ;;
        rootfstype=*) fstype="${bootarg##rootfstype=}" ;;
    esac
done

if [ "$foundslotsfx" != "yes" ]; then
    # This variable file contains a type (should be 6) followed by the value (should be 0 or 1)
    # awk splits on runs of whitespace and ignores the leading blank hexdump
    # emits, which is what the nested echo used to be doing.
    bcdata=$(hexdump -n 8 -e '2/4 " %u"' /sys/firmware/efi/efivars/BootChainOsCurrent-781e084c-a330-417c-b678-38e696380cb9 2>/dev/null || true)
    if [ "$(echo "$bcdata" | awk '{print $1}')" = "6" ]; then
        slotnum=$(echo "$bcdata" | awk '{print $2}')
        [ "$slotnum" != "1" ] || slotsfx="_b"
    fi

    message="Waiting for APP$slotsfx partition..."
    printf '%s' "$message"
    for _ in $(seq 1 10); do
        for dev in $(lsblk -dnpo NAME); do
          blkid --probe "$dev" || true
        done
        rootdev=$(blkid -l -t "PARTLABEL=APP$slotsfx" | cut -d: -f1)
        if [ -n "$rootdev" ]; then
            echo "[OK: $rootdev]"
            break
        fi
        printf '%s' "$message"
        message="."
        sleep 0.5
    done
fi

# mount it
if [ -z "$rootdev" ]; then
    echo "Error: rootdev is not set"
    exit 1
fi

mount "$rootdev" /sysroot

# Mount var partition by finding DATAPART_EXPAND.
# Search order: same disk as rootfs first (handles dual-install), then other disks
# (handles split layout: e.g. OS on eMMC, data on NVMe).

# Helper: scan a disk's partitions for DATAPART_EXPAND via sysfs uevent
find_datapart_on_disk() {
    # `local` is not POSIX, but busybox ash implements it and it is load-bearing
    # here: the caller iterates its own `diskname`, which this would otherwise
    # overwrite mid-loop.
    # shellcheck disable=SC3043
    local diskname="$1"
    for partdir in "/sys/block/$diskname/${diskname}"p*; do
        [ -d "$partdir" ] || continue
        if [ -f "$partdir/uevent" ]; then
            while IFS='=' read -r key val; do
                if [ "$key" = "PARTNAME" ] && [ "$val" = "DATAPART_EXPAND" ]; then
                    echo "/dev/$(basename "$partdir")"
                    return 0
                fi
            done < "$partdir/uevent"
        fi
    done
    return 1
}

case "$rootdev" in
  /dev/nvme*|/dev/mmc*) rootdisk="${rootdev%p*}" ;;
  /dev/sd*)             rootdisk="${rootdev%[0-9]*}" ;;
  *)                    rootdisk="" ;;
esac

vardev=""

# First: check the same disk as rootfs (preferred for single-disk installs)
if [ -n "$rootdisk" ]; then
    rootdiskname=$(basename "$rootdisk")
    echo "Looking for DATAPART_EXPAND on rootfs disk ($rootdiskname)..."
    vardev=$(find_datapart_on_disk "$rootdiskname") || true
fi

# Second: if not found on rootfs disk, search all other block devices
# This supports split layouts (e.g. OS on eMMC, data on NVMe)
if [ -z "$vardev" ]; then
    echo "DATAPART_EXPAND not on rootfs disk, scanning other disks..."
    for disk in /sys/block/*; do
        diskname=$(basename "$disk")
        # Skip non-storage devices (loop, ram, zram) and the rootfs disk
        case "$diskname" in
            loop*|ram*|zram*|mtd*) continue ;;
        esac
        [ "$diskname" = "${rootdiskname:-}" ] && continue
        vardev=$(find_datapart_on_disk "$diskname") || true
        if [ -n "$vardev" ]; then
            echo "Found DATAPART_EXPAND on $diskname"
            break
        fi
    done
fi

if [ -n "$vardev" ]; then
    echo "Mounting var partition: $vardev"
    mount "$vardev" /sysroot/var
else
    echo "WARNING: DATAPART_EXPAND not found on any disk"
fi
