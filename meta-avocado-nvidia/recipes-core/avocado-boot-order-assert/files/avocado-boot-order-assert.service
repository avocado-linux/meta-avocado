[Unit]
Description=Assert BootOrder for a just-flashed medium, if a marker asks for it
DefaultDependencies=no
After=avocado-tegra-init.service
Before=initrd-root-fs.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/avocado-boot-order-assert
RemainAfterExit=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
MountFlags=shared
PrivateDevices=no
ProtectSystem=no
ProtectHome=no

[Install]
WantedBy=initrd-root-fs.target
