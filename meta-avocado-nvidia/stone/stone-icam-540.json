{
  "runtime": {
    "platform": "avocado-icam-540",
    "architecture": "arm64",
    "provision_default": "tegraflash",
    "update_strategy": "tegra-ab"
  },
  "update": {
    "slot_detection": {
      "type": "command",
      "command": ["nvbootctrl", "get-current-slot"]
    },
    "os_artifacts": {
      "rootfs": { "image_key": "rootfs", "slot_partitions": ["APP", "APP_b"] }
    },
    "activate": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{inactive_slot}"]
      }
    ],
    "rollback": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{previous_slot}"]
      }
    ]
  },
  "provision": {
    "envs": {
      "flash_options": {
        "ERASE_NVME": "${ERASE_NVME}",
        "ERASE_ONLY": "${ERASE_ONLY}"
      }
    },
    "fields": {
      "ERASE_NVME": {
        "type": "boolean",
        "label": "Erase NVMe before flash",
        "description": "When enabled, the target's NVMe storage is wiped before flashing.",
        "required": false,
        "default": false
      },
      "ERASE_ONLY": {
        "type": "boolean",
        "label": "Erase only (skip flash)",
        "description": "When enabled, erase the selected storage and do not flash a new image.",
        "required": false,
        "default": false
      }
    },
    "profiles": {
      "tegraflash": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-nvme": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "noop": {
        "script": "stone-provision-noop.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-icam-540",
      "devpath": "/dev/nvme0n1",
      "block_size": 512,
      "partitions": [],
      "images": {
        "rootfs": "avocado-image-rootfs-icam-540.erofs-lz4",
        "var": "avocado-image-var-icam-540.btrfs",
        "initramfs": "avocado-image-initramfs-icam-540.cpio.gz",
        "tegraflash_initramfs": "tegra-initrd-flash-initramfs-avocado-icam-540.cboot",
        "tegraflash_esp": "tegra-espimage-avocado-icam-540.esp",
        "tegraflash_tos": "tos-avocado-icam-540.img",
        "tegraflash_bsp": "tegraflash-bsp",
        "tegraflash_tools": "tegraflash-tools"
      },
      "tegraflash": {
        "overlays": [
          "tegra234-p3768-0000+p3767-0000-dynamic.dtbo",
          "tegra234-dcb-p3767-0000-hdmi.dtbo"
        ],
        "dce_overlays": [
          "tegra234-dcb-p3767-0000-hdmi.dtbo"
        ]
      }
    }
  }
}
