{
  "runtime": {
    "platform": "avocado-jetson-orin-nano-devkit",
    "architecture": "arm64",
    "provision_default": "tegraflash"
  },
  "provision": {
    "profiles": {
      "tegraflash": {
        "script": "stone-provision-tegraflash.sh"
      },
      "noop": {
        "script": "stone-provision-noop.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-rootfs-jetson-orin-nano-devkit.tegraflash.tar.gz",
      "devpath": "/dev/nvme0n1",
      "block_size": 512,
      "partitions": [],
      "images": {
        "tegraflash": "avocado-image-rootfs-jetson-orin-nano-devkit.tegraflash.tar.gz",
        "rootfs": "avocado-image-rootfs-jetson-orin-nano-devkit.squashfs",
        "var": "avocado-image-var-jetson-orin-nano-devkit.btrfs"
      }
    }
  }
}
