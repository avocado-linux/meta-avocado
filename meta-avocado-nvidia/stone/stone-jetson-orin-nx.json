{
  "runtime": {
    "platform": "avocado-jetson-orin-nx",
    "architecture": "arm64",
    "provision_default": "tegraflash",
    "update_strategy": "tegra-ab"
  },
  "update": {
    "slot_detection": {
      "type": "command",
      "command": ["nvbootctrl", "get-current-slot"]
    },
    "os_artifacts": {
      "rootfs": { "image_key": "rootfs", "slot_partitions": ["APP", "APP_b"] }
    },
    "activate": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{inactive_slot}"]
      }
    ],
    "rollback": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{previous_slot}"]
      }
    ]
  },
  "provision": {
    "envs": {
      "flash_options": {
        "ERASE_NVME": "${ERASE_NVME}",
        "ERASE_EMMC": "${ERASE_EMMC}",
        "ERASE_ONLY": "${ERASE_ONLY}",
        "BOARDCTL_TARGET": "${BOARDCTL_TARGET}",
        "BOARDCTL_SERIAL": "${BOARDCTL_SERIAL}"
      }
    },
    "fields": {
      "ERASE_NVME": {
        "type": "boolean",
        "label": "Erase NVMe before flash",
        "description": "When enabled, the target's NVMe storage is wiped before flashing.",
        "required": false,
        "default": false
      },
      "ERASE_EMMC": {
        "type": "boolean",
        "label": "Erase eMMC before flash",
        "description": "When enabled, the target's eMMC storage is wiped before flashing.",
        "required": false,
        "default": false
      },
      "ERASE_ONLY": {
        "type": "boolean",
        "label": "Erase only (skip flash)",
        "description": "When enabled, erase the selected storage and do not flash a new image.",
        "required": false,
        "default": false
      },
      "BOARDCTL_TARGET": {
        "type": "string",
        "label": "boardctl target",
        "description": "Target name passed to boardctl to drive the carrier (e.g. relays/power). Leave empty to skip.",
        "required": false
      },
      "BOARDCTL_SERIAL": {
        "type": "string",
        "label": "boardctl serial",
        "description": "Serial number of the boardctl-managed carrier; only used when boardctl target is set.",
        "required": false
      }
    },
    "profiles": {
      "tegraflash": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-nvme": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-mmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-emmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-sd": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "noop": {
        "script": "stone-provision-noop.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-jetson-orin-nx",
      "devpath": "/dev/nvme0n1",
      "block_size": 512,
      "partitions": [],
      "images": {
        "rootfs": "avocado-image-rootfs-jetson-orin-nx.erofs-lz4",
        "var": "avocado-image-var-jetson-orin-nx.btrfs",
        "initramfs": "avocado-image-initramfs-jetson-orin-nx.cpio.gz",
        "tegraflash_initramfs": "tegra-initrd-flash-initramfs-avocado-jetson-orin-nx.cboot",
        "tegraflash_esp": "tegra-espimage-avocado-jetson-orin-nx.esp",
        "tegraflash_tos": "tos-avocado-jetson-orin-nx.img",
        "tegraflash_bsp": "tegraflash-bsp",
        "tegraflash_tools": "tegraflash-tools",
        "tegraflash_carrier_bsp": "carrier-bsp"
      },
      "tegraflash": {
        "sd_device": "mmcblk1"
      }
    }
  }
}
