{
  "runtime": {
    "platform": "avocado-jetson-orin-nano",
    "architecture": "arm64",
    "provision_default": "tegraflash",
    "update_strategy": "tegra-ab"
  },
  "update": {
    "slot_detection": {
      "type": "command",
      "command": ["nvbootctrl", "get-current-slot"]
    },
    "os_artifacts": {
      "rootfs": { "image_key": "rootfs", "slot_partitions": ["APP", "APP_b"] }
    },
    "activate": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{inactive_slot}"]
      }
    ],
    "rollback": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{previous_slot}"]
      }
    ]
  },
  "provision": {
    "envs": {
      "flash_options": {
        "ERASE_NVME": "${ERASE_NVME}",
        "ERASE_EMMC": "${ERASE_EMMC}",
        "ERASE_ONLY": "${ERASE_ONLY}"
      }
    },
    "fields": {
      "ERASE_NVME": {
        "type": "boolean",
        "label": "Erase NVMe before flash",
        "description": "When enabled, the target's NVMe storage is wiped before flashing.",
        "required": false,
        "default": false
      },
      "ERASE_EMMC": {
        "type": "boolean",
        "label": "Erase eMMC before flash",
        "description": "When enabled, the target's eMMC storage is wiped before flashing.",
        "required": false,
        "default": false
      },
      "ERASE_ONLY": {
        "type": "boolean",
        "label": "Erase only (skip flash)",
        "description": "When enabled, erase the selected storage and do not flash a new image.",
        "required": false,
        "default": false
      }
    },
    "profiles": {
      "tegraflash": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-nvme": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-mmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-emmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-sd": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "noop": {
        "script": "stone-provision-noop.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-jetson-orin-nano",
      "devpath": "/dev/nvme0n1",
      "block_size": 512,
      "partitions": [],
      "images": {
        "rootfs": "avocado-image-rootfs-jetson-orin-nano.erofs-lz4",
        "var": "avocado-image-var-jetson-orin-nano.btrfs",
        "initramfs": "avocado-image-initramfs-jetson-orin-nano.cpio.zst",
        "tegraflash_initramfs": "tegra-initrd-flash-initramfs-avocado-jetson-orin-nano.cboot",
        "tegraflash_esp": "tegra-espimage-avocado-jetson-orin-nano.esp",
        "tegraflash_tos": "tos-avocado-jetson-orin-nano.img",
        "tegraflash_bsp": "tegraflash-bsp",
        "tegraflash_tools": "tegraflash-tools",
        "tegraflash_carrier_bsp": "carrier-bsp"
      }
    }
  }
}
