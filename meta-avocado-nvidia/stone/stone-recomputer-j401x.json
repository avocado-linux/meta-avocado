{
  "runtime": {
    "platform": "avocado-recomputer-j401x",
    "architecture": "arm64",
    "provision_default": "tegraflash"
  },
  "provision": {
    "envs": {
      "flash_options": {
        "ERASE_NVME": "${ERASE_NVME}",
        "ERASE_EMMC": "${ERASE_EMMC}",
        "ERASE_ONLY": "${ERASE_ONLY}"
      }
    },
    "profiles": {
      "tegraflash": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-nvme": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-mmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-emmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-sd": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "noop": {
        "script": "stone-provision-noop.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-recomputer-j401x",
      "devpath": "/dev/nvme0n1",
      "block_size": 512,
      "partitions": [],
      "images": {
        "rootfs": "avocado-image-rootfs-recomputer-j401x.erofs-lz4",
        "var": "avocado-image-var-recomputer-j401x.btrfs",
        "initramfs": "avocado-image-initramfs-recomputer-j401x.cpio.gz",
        "tegraflash_initramfs": "tegra-initrd-flash-initramfs-avocado-recomputer-j401x.cboot",
        "tegraflash_esp": "tegra-espimage-avocado-recomputer-j401x.esp",
        "tegraflash_tos": "tos-avocado-recomputer-j401x.img",
        "tegraflash_bsp": "tegraflash-bsp",
        "tegraflash_tools": "tegraflash-tools"
      }
    }
  }
}
