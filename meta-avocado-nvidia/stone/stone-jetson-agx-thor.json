{
  "runtime": {
    "platform": "avocado-jetson-agx-thor",
    "architecture": "arm64",
    "provision_default": "tegraflash",
    "update_strategy": "tegra-ab"
  },
  "update": {
    "slot_detection": {
      "type": "command",
      "command": ["nvbootctrl", "get-current-slot"]
    },
    "os_artifacts": {
      "rootfs": { "image_key": "rootfs", "slot_partitions": ["APP", "APP_b"] },
      "boot": { "image_key": "boot", "slot_partitions": ["A_kernel", "B_kernel"] }
    },
    "activate": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{inactive_slot}"]
      }
    ],
    "rollback": [
      {
        "type": "command",
        "command": ["nvbootctrl", "set-active-boot-slot", "{previous_slot}"]
      }
    ]
  },
  "provision": {
    "envs": {
      "flash_options": {
        "ERASE_NVME": "${ERASE_NVME}",
        "ERASE_EMMC": "${ERASE_EMMC}",
        "ERASE_ONLY": "${ERASE_ONLY}",
        "BOARDCTL_TARGET": "${BOARDCTL_TARGET}",
        "BOARDCTL_SERIAL": "${BOARDCTL_SERIAL}"
      }
    },
    "profiles": {
      "tegraflash": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-nvme": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-mmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-emmc": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "tegraflash-sd": {
        "script": "stone-provision-tegraflash.sh",
        "envs": ["flash_options"]
      },
      "noop": {
        "script": "stone-provision-noop.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-jetson-agx-thor",
      "devpath": "/dev/nvme0n1",
      "block_size": 512,
      "partitions": [],
      "images": {
        "rootfs": "avocado-image-rootfs-jetson-agx-thor.erofs-lz4",
        "var": "avocado-image-var-jetson-agx-thor.btrfs",
        "initramfs": "avocado-image-initramfs-jetson-agx-thor.cpio.zst",
        "boot": {
          "out": "boot.img",
          "size": 128,
          "size_unit": "mebibytes"
        },
        "tegraflash_initramfs": "tegra-initrd-flash-initramfs-avocado-jetson-agx-thor.cboot",
        "tegraflash_esp": "tegra-espimage-avocado-jetson-agx-thor.esp",
        "tegraflash_tos": "tos-avocado-jetson-agx-thor.img",
        "tegraflash_bsp": "tegraflash-bsp",
        "tegraflash_tools": "tegraflash-tools",
        "tegraflash_carrier_bsp": "carrier-bsp"
      }
    }
  }
}
