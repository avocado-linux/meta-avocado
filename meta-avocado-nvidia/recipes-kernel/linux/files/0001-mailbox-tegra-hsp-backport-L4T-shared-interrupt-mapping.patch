From 0c05396b244b04882da12c5f7fa9339cc6c437b1 Mon Sep 17 00:00:00 2001
From: Justin Schneck <j.schneck@peridio.com>
Date: Mon, 2 Feb 2026 15:25:54 -0500
Subject: [PATCH] mailbox: tegra-hsp: enable per-mailbox IE for Tegra234/264

Enable per-mailbox interrupt enable (has_per_mb_ie) for Tegra234 and
Tegra264 HSP configurations. This is required for proper communication
with the Real-time Camera Engine (RCE) firmware on Orin platforms.

Without this fix, the HSP mailbox driver uses the legacy interrupt
routing which doesn't properly handle the per-mailbox interrupt enable
registers that the RCE firmware expects, causing camera subsystem
initialization to fail.

This aligns with NVIDIA's L4T kernel behavior where Tegra234 has
has_per_mb_ie = true.

Signed-off-by: Justin Schneck <j.schneck@peridio.com>
---
 drivers/mailbox/tegra-hsp.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/mailbox/tegra-hsp.c b/drivers/mailbox/tegra-hsp.c
index 185a2e7..679011e 100644
--- a/drivers/mailbox/tegra-hsp.c
+++ b/drivers/mailbox/tegra-hsp.c
@@ -956,7 +956,7 @@ static const struct tegra_hsp_soc tegra194_hsp_soc = {
 
 static const struct tegra_hsp_soc tegra234_hsp_soc = {
         .map = tegra186_hsp_db_map,
-        .has_per_mb_ie = false,
+        .has_per_mb_ie = true,
         .has_128_bit_mb = true,
         .reg_stride = 0x100,
         .si_shift = 16,
@@ -973,7 +973,7 @@ static const struct tegra_hsp_soc tegra234_hsp_soc = {
 
 static const struct tegra_hsp_soc tegra264_hsp_soc = {
         .map = tegra186_hsp_db_map,
-        .has_per_mb_ie = false,
+        .has_per_mb_ie = true,
         .has_128_bit_mb = true,
         .reg_stride = 0x1000,
         .si_shift = 17,
-- 
2.43.0

