#!/usr/bin/env bash

set -e

hook="avocado-provision"
target="jetson-orin-nx"

RUNTIME_NAME="$1"

input_dir="$AVOCADO_PREFIX/output/runtimes/$RUNTIME_NAME/stone"
manifest="${AVOCADO_STONE_MANIFEST:-$AVOCADO_SDK_PREFIX/stone/stone-${target}.json}"

# Build include path flags from AVOCADO_STONE_INCLUDE_PATHS.
#
# Order matters: stone's `find_file_in_dirs` returns the first hit, so
# earlier paths win. For provision, the priority order is:
#   1. Runtime output dir — the build-time bundle. Contains the
#      composed-and-overridden artifacts produced by `avocado build`,
#      including the extension-driven carrier-bsp overlay. This must
#      win for everything that's already bundled.
#   2. Extension paths — fallback for anything the bundle doesn't
#      contain (typically nothing at provision time).
#   3. SDK stone dir — MACHINE-baked fallback.
build_include_flags() {
    local main_input_dir="$1"
    local include_flags=""

    include_flags="$include_flags -i \"$main_input_dir\""

    if [ -n "${AVOCADO_STONE_INCLUDE_PATHS:-}" ]; then
        for path in $AVOCADO_STONE_INCLUDE_PATHS; do
            if [ -n "$path" ]; then
                include_flags="$include_flags -i \"$path\""
            fi
        done
    fi

    if [ -n "$AVOCADO_SDK_PREFIX" ]; then
        include_flags="$include_flags -i \"$AVOCADO_SDK_PREFIX/stone\""
    fi

    echo "$include_flags"
}

# Build display string of all include paths
build_include_display() {
    local main_input_dir="$1"
    local display=""

    display="${display}\n    - ${main_input_dir}"

    if [ -n "${AVOCADO_STONE_INCLUDE_PATHS:-}" ]; then
        for path in $AVOCADO_STONE_INCLUDE_PATHS; do
            if [ -n "$path" ]; then
                display="${display}\n    - ${path}"
            fi
        done
    fi

    if [ -n "$AVOCADO_SDK_PREFIX" ]; then
        display="${display}\n    - ${AVOCADO_SDK_PREFIX}/stone"
    fi

    echo -e "$display"
}

echo -e "\033[94m[INFO]\033[0m Running stone provision.
  Input directories:$(build_include_display "$input_dir")"

include_flags=$(build_include_flags "$input_dir")
eval stone provision $include_flags


echo -e "\033[92m[SUCCESS]\033[0m Successfully ran SDK lifecycle hook '$hook' for target '$target'."
exit 0
