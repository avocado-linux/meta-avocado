{
  "runtime": {
    "platform": "avocado-intel-x86-64-v3",
    "architecture": "x86_64",
    "provision_default": "img"
  },
  "provision": {
    "profiles": {
      "img": {
        "script": "stone-provision-img.sh"
      },
      "usb": {
        "script": "stone-provision-usb.sh"
      },
      "peridio": {
        "script": "stone-provision-peridio.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-intel-x86-64-v3",
      "devpath": "/dev/sda",
      "block_size": 512,
      "partitions": [],
      "images": {
        "rootfs": "avocado-image-rootfs-intel-x86-64-v3.erofs-lz4",
        "var": "avocado-image-var-intel-x86-64-v3.btrfs",
        "initramfs": "avocado-image-initramfs-intel-x86-64-v3.cpio.zst",
        "kernel": "bzImage",
        "bootloader": "systemd-bootx64.efi"
      }
    }
  }
}
