#!/bin/sh
# avocado-efi-slot-entries - make sure UEFI has one boot entry per A/B boot
# slot on the disk this system booted from, labelled the way avocadoctl's
# `efibootmgr` slot action looks them up (the stone manifest's slot_entries:
# boot-a, boot-b).
#
# Provisioning writes the disk image and nothing else, so firmware only ever
# creates its own entries: on the R8000 that is a PXE entry and a removable-
# media 'UEFI OS' entry pointing at the first ESP. Without an entry per slot,
# activation cannot find the target slot, and the second ESP is unreachable.
#
# The disk comes from LoaderDevicePartUUID, the ESP systemd-boot was loaded
# from, so a same-named partition on another disk is never used.
#
# BootOrder belongs to avocadoctl: commit moves the committed slot to the
# front, and a rollback that runs without a reboot leaves the failed slot
# running. So this script never promotes the slot it booted. A replaced entry
# takes the position of the one it replaces, a slot missing from BootOrder goes
# next to the other slot, and only when no slot is in BootOrder at all (first
# boot) do the slots go to the front, booted slot first.
set -eu

efivars=${AVOCADO_EFI_SLOTS_EFIVARS:-/sys/firmware/efi/efivars}
devdir=${AVOCADO_EFI_SLOTS_DEVDIR:-/dev}
sysblock=${AVOCADO_EFI_SLOTS_SYSBLOCK:-/sys/class/block}
slots=${AVOCADO_EFI_SLOTS_LABELS:-boot-a boot-b}
loader='\EFI\BOOT\BOOTX64.EFI'

log() { echo "avocado-efi-slot-entries: $*"; }

var=$efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
[ -r "$var" ] || { log "no LoaderDevicePartUUID, not booted through systemd-boot; nothing to do"; exit 0; }

# local-fs.target only waits for what is mounted. The other slot's ESP is not
# mounted, so its by-partuuid link can still be in flight from coldplug, and
# skipping that slot would leave it without an entry until the next boot.
if [ -z "${AVOCADO_EFI_SLOTS_NO_SETTLE:-}" ] && command -v udevadm >/dev/null 2>&1; then
    udevadm settle --timeout=30 || log "udevadm settle timed out, continuing"
fi

# efivarfs prefixes 4 attribute bytes; the rest is a UTF-16LE GUID string.
booted=$(tail -c +5 "$var" | tr -d '\000\n' | tr 'A-F' 'a-f')
esp=$(readlink -f "$devdir/disk/by-partuuid/$booted" 2>/dev/null) || esp=
[ -n "$esp" ] && [ -e "$esp" ] || { log "booted ESP $booted has no block device"; exit 1; }
disk=$(basename "$(readlink -f "$sysblock/$(basename "$esp")/..")")

# Partition device name for a GPT partition label, on the booted disk only.
part_for_label() {
    for u in "$sysblock/$disk"/*/uevent; do
        [ -r "$u" ] || continue
        grep -qxF "PARTNAME=$1" "$u" && { basename "$(dirname "$u")"; return 0; }
    done
    return 1
}

partuuid_of() {
    for l in "$devdir"/disk/by-partuuid/*; do
        [ "$(readlink -f "$l")" = "$(readlink -f "$devdir/$1")" ] && { basename "$l" | tr 'A-F' 'a-f'; return 0; }
    done
    return 1
}

# Callers capture this with `x=$(efibootmgr_out ...)`, so a failure fails the
# assignment and set -e stops the run. Read as empty output instead, a failed
# listing would make every slot look missing and create duplicates, and a
# failed BootOrder read would drop every non-slot entry from the order.
efibootmgr_out() {
    efibootmgr "$@" || { log "efibootmgr $* failed" >&2; return 1; }
}

# Every entry number carrying exactly this label, as avocadoctl matches it.
# Firmware resets and repeated provisioning can leave more than one.
entries_for_label() {
    printf '%s\n' "$2" | awk -v want="$1" '
        /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ {
            num = substr($0, 5, 4); rest = substr($0, 9)
            sub(/^\*/, "", rest); sub(/^ +/, "", rest)
            label = rest; sub(/\t.*/, "", label); sub(/ +$/, "", label)
            if (label == want) print num
        }'
}

# Every entry with this label whose device path names this PARTUUID.
good_entries() {
    for n in $(entries_for_label "$1" "$3"); do
        printf '%s\n' "$3" | grep "^Boot$n" | tr 'A-F' 'a-f' | grep -q "$2" && echo "$n"
    done
    return 0
}

# Of several good duplicates keep the one firmware is about to use (BootNext),
# is using (BootCurrent) or will try first, so deleting the others moves nothing
# avocadoctl pointed at.
pick() {
    for want in $prefs; do
        for n in $1; do [ "$n" = "$want" ] && { echo "$n"; return 0; }; done
    done
    for n in $1; do echo "$n"; return 0; done
    return 1
}

# BootOrder with every occurrence of $2 replaced by $3, duplicates dropped.
# When $2 sits ahead of $3 the kept entry moves up into $2's place: that is
# the position whoever wrote BootOrder last (normally avocadoctl's commit)
# gave the slot.
swap_in_order() {
    printf '%s\n' "$1" | awk -F, -v from="$2" -v to="$3" '{
        for (i = 1; i <= NF; i++) {
            e = ($i == from) ? to : $i
            if (e != "" && !(e in seen)) { seen[e] = 1; out = out (out == "" ? "" : ",") e }
        }
        print out }'
}

boot_order() {
    o=$(efibootmgr_out) || return 1
    printf '%s\n' "$o" | sed -n 's/^BootOrder: //p'
}

nv=$(efibootmgr_out -v)
next=$(printf '%s\n' "$nv" | sed -n 's/^BootNext: //p')
prefs="$next $(printf '%s\n' "$nv" | sed -n 's/^BootCurrent: //p') $(printf '%s\n' "$nv" | sed -n 's/^BootOrder: //p' | tr ',' ' ')"

kept=
for s in $slots; do
    p=$(part_for_label "$s") || { log "no partition labelled $s on /dev/$disk, skipping it"; continue; }
    uuid=$(partuuid_of "$p") || { log "$p has no PARTUUID link, skipping $s"; continue; }
    keep=$(pick "$(good_entries "$s" "$uuid" "$nv")") || keep=
    if [ -z "$keep" ]; then
        partno=$(cat "$sysblock/$p/partition")
        log "creating '$s' for /dev/$p (partition $partno of /dev/$disk)"
        # -C, not -c: -c prepends to BootOrder, which would promote this slot.
        efibootmgr -q -C -d "$devdir/$disk" -p "$partno" -L "$s" -l "$loader"
        nv=$(efibootmgr_out -v)
        keep=$(pick "$(good_entries "$s" "$uuid" "$nv")") || { log "created '$s' but efibootmgr does not list it"; exit 1; }
    fi
    # Stale and duplicate entries go only once a good one exists. Before each
    # delete, the kept entry takes over the doomed one's BootOrder position and
    # any BootNext pointing at it, so an NVRAM write failing at any point
    # leaves nothing naming an entry that no longer exists: a lost BootNext
    # would drop a pending trial or rollback, and -B also removes the number
    # from BootOrder, which would push the slot out of it.
    for n in $(entries_for_label "$s" "$nv"); do
        [ "$n" = "$keep" ] && continue
        log "removing Boot$n '$s', it duplicates Boot$keep or points elsewhere"
        order=$(boot_order)
        swapped=$(swap_in_order "$order" "$n" "$keep")
        if [ "$swapped" != "$order" ]; then
            log "BootOrder $order -> $swapped (Boot$keep takes Boot$n's place)"
            efibootmgr -q -o "$swapped"
        fi
        if [ "$n" = "$next" ]; then
            log "BootNext Boot$n is being removed, pointing it at Boot$keep"
            efibootmgr -q -n "$keep"
            next=$keep
        fi
        efibootmgr -q -b "$n" -B
    done
    if [ "$uuid" = "$booted" ]; then kept="$keep $kept"; else kept="$kept $keep"; fi
done

# Only slots still missing from BootOrder are added: next to the other slot
# when one is there, at the front (booted slot first) when none is (first boot).
current=$(boot_order)
wanted=$(awk -v order="$current" -v slots="$kept" 'BEGIN {
    ns = split(slots, sl, " "); for (i = 1; i <= ns; i++) isslot[sl[i]] = 1
    no = split(order, od, ","); n = 0; last = 0
    for (i = 1; i <= no; i++) {
        if (od[i] == "" || od[i] in seen) continue
        seen[od[i]] = 1; out[++n] = od[i]; if (od[i] in isslot) last = n
    }
    miss = ""; for (i = 1; i <= ns; i++) if (!(sl[i] in seen)) miss = miss " " sl[i]
    nmiss = split(miss, mv, " ")
    for (i = 1; i <= n; i++) {
        if (last == 0 && i == 1) for (j = 1; j <= nmiss; j++) r = r (r == "" ? "" : ",") mv[j]
        r = r (r == "" ? "" : ",") out[i]
        if (last == i) for (j = 1; j <= nmiss; j++) r = r "," mv[j]
    }
    if (n == 0) for (j = 1; j <= nmiss; j++) r = r (r == "" ? "" : ",") mv[j]
    print r
}')
[ "$wanted" = "$current" ] && exit 0
efibootmgr -q -o "$wanted"
log "BootOrder now $wanted (was $current)"
