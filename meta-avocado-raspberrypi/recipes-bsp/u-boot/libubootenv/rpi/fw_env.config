# fw_printenv and fw_setenv configuration
#
# This static config is overridden at runtime by avocado-uboot-env.service
# which mounts the env FAT partition and generates /run/avocado/fw_env.config
# with paths to the mounted env files.
#
# /etc/fw_env.config is a symlink to /run/avocado/fw_env.config.
#
# Fallback for SD card boot: env FAT partition = /dev/mmcblk0p2
# The env files (uboot.env, uboot.env.redund) live on this FAT partition.
# They must be accessed via mount, not raw offsets (FAT cluster allocation).

# Device name	Device offset	Env. size	Flash sector size	Number of sectors
/dev/mmcblk0p2	0x0		0x20000		0x200			256
/dev/mmcblk0p2	0x20000		0x20000		0x200			256
