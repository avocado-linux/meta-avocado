#!/bin/sh
# avocado-uboot-env: Mount the U-Boot env FAT partition and generate
# /run/avocado/fw_env.config for fw_printenv/fw_setenv.
#
# The U-Boot environment is stored as files (uboot.env + uboot.env.redund)
# on a dedicated FAT partition (partition 2 on the boot device).
#
# Priority:
#   1. User override at /var/lib/avocado/fw_env.config
#   2. Auto-detect from kernel cmdline root= parameter
#
# For MMC devices, the env partition is /dev/mmcblkNp2.
# For NVMe devices, the env partition is /dev/nvme0n1p2.

set -e

RUNTIME_CONFIG="/run/avocado/fw_env.config"
USER_OVERRIDE="/var/lib/avocado/fw_env.config"
ENV_MOUNTPOINT="/run/avocado/uboot-env"
ENV_SIZE="0x20000"

# Partition number for the env FAT partition (always partition 2)
ENV_PART_NUM=2

mkdir -p /run/avocado

# Check for user-provided override first
if [ -f "$USER_OVERRIDE" ]; then
    echo "avocado-uboot-env: using user override from $USER_OVERRIDE"
    cp "$USER_OVERRIDE" "$RUNTIME_CONFIG"
    exit 0
fi

# Auto-detect boot device from kernel cmdline
root_dev=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=/dev/mmcblk*)
            root_dev="${arg#root=}"
            ;;
        root=/dev/nvme*)
            root_dev="${arg#root=}"
            ;;
        root=/dev/sd*)
            root_dev="${arg#root=}"
            ;;
    esac
done

if [ -z "$root_dev" ]; then
    echo "avocado-uboot-env: ERROR: could not determine boot device from /proc/cmdline" >&2
    exit 1
fi

# Extract the base device and determine the env partition device
case "$root_dev" in
    /dev/mmcblk*p*)
        # /dev/mmcblk0p3 -> /dev/mmcblk0
        base_dev=$(echo "$root_dev" | sed 's|p[0-9]*$||')
        env_dev="${base_dev}p${ENV_PART_NUM}"
        ;;
    /dev/nvme*p*)
        # /dev/nvme0n1p3 -> /dev/nvme0n1
        base_dev=$(echo "$root_dev" | sed 's|p[0-9]*$||')
        env_dev="${base_dev}p${ENV_PART_NUM}"
        ;;
    /dev/sd*)
        # /dev/sda3 -> /dev/sda
        base_dev=$(echo "$root_dev" | sed 's|[0-9]*$||')
        env_dev="${base_dev}${ENV_PART_NUM}"
        ;;
    *)
        echo "avocado-uboot-env: ERROR: unsupported root device format: $root_dev" >&2
        exit 1
        ;;
esac

echo "avocado-uboot-env: boot device is $base_dev"
echo "avocado-uboot-env: env partition is $env_dev"

# Verify the env partition exists
if [ ! -b "$env_dev" ]; then
    echo "avocado-uboot-env: ERROR: env partition $env_dev does not exist" >&2
    exit 1
fi

# Mount the env FAT partition
mkdir -p "$ENV_MOUNTPOINT"
if ! mount -t vfat "$env_dev" "$ENV_MOUNTPOINT"; then
    echo "avocado-uboot-env: ERROR: failed to mount $env_dev at $ENV_MOUNTPOINT" >&2
    exit 1
fi

echo "avocado-uboot-env: mounted $env_dev at $ENV_MOUNTPOINT"

# Generate fw_env.config pointing to the mounted env files
cat > "$RUNTIME_CONFIG" << EOF
# Auto-generated by avocado-uboot-env
# Env FAT partition: $env_dev mounted at $ENV_MOUNTPOINT
# To override, place your own config at $USER_OVERRIDE
${ENV_MOUNTPOINT}/uboot.env	0x0	${ENV_SIZE}
${ENV_MOUNTPOINT}/uboot.env.redund	0x0	${ENV_SIZE}
EOF

echo "avocado-uboot-env: wrote $RUNTIME_CONFIG"
