# U-Boot environment stored on FAT filesystem (eMMC target)
# Env lives on a dedicated FAT partition separate from boot A/B
# to survive OTA updates that rewrite boot partitions.
#
# eMMC device number in U-Boot varies by board:
#   CM4: mmc 1 = eMMC (verify on hardware)
#   CM5: TBD
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_FLASH is not set
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="mmc"
CONFIG_ENV_FAT_DEVICE_AND_PART="1:2"
CONFIG_ENV_FAT_FILE="/uboot.env"
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_FAT_FILE_REDUND="/uboot.env.redund"
CONFIG_ENV_SIZE=0x20000
