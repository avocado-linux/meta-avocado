#!/usr/bin/env bash

set -e

hook="avocado-build"
target="$AVOCADO_TARGET"

RUNTIME_NAME="$1"

output_dir="$AVOCADO_PREFIX/output/runtimes/$RUNTIME_NAME"

mkdir -p "$output_dir"

input_dir="$AVOCADO_PREFIX/runtimes/$RUNTIME_NAME"
output_dir="$AVOCADO_PREFIX/output/runtimes/$RUNTIME_NAME/stone"
manifest="${AVOCADO_STONE_MANIFEST:-$AVOCADO_SDK_PREFIX/stone/stone-${target}.json}"

# Build include path flags from AVOCADO_STONE_INCLUDE_PATHS
build_include_flags() {
  local main_input_dir="$1"
  local include_flags=""

  if [ -n "$AVOCADO_STONE_INCLUDE_PATHS" ]; then
    IFS=':' read -ra PATHS <<<"$AVOCADO_STONE_INCLUDE_PATHS"
    for path in "${PATHS[@]}"; do
      if [ -n "$path" ]; then
        include_flags="$include_flags -i \"$path\""
      fi
    done
  fi

  include_flags="$include_flags -i \"$main_input_dir\""
  echo "$include_flags"
}

# Build display string of all include paths
build_include_display() {
  local main_input_dir="$1"
  local display=""

  if [ -n "$AVOCADO_STONE_INCLUDE_PATHS" ]; then
    IFS=':' read -ra PATHS <<<"$AVOCADO_STONE_INCLUDE_PATHS"
    for path in "${PATHS[@]}"; do
      if [ -n "$path" ]; then
        display="${display}\n    - ${path}"
      fi
    done
  fi

  display="${display}\n    - ${main_input_dir}"
  echo -e "$display"
}

echo -e "\033[94m[INFO]\033[0m Running stone validate.
  Manifest:          ${manifest}
  Input directories:$(build_include_display "$input_dir")"

include_flags=$(build_include_flags "$input_dir")
# $include_flags is a pre-quoted "-i <path>" list built above and must word-split
# into separate arguments; quoting it would pass one argument containing spaces.
# shellcheck disable=SC2086
eval stone validate -m "\"${manifest}\"" $include_flags

echo -e "\033[94m[INFO]\033[0m Running stone create.
  Manifest:          ${manifest}
  Input directories:$(build_include_display "$input_dir")
  Output directory:  ${output_dir}"

# $include_flags must word-split here for the same reason as above.
# shellcheck disable=SC2086
eval stone create --os-release "\"${AVOCADO_PREFIX}/rootfs/usr/lib/os-release\"" -m "\"$manifest\"" $include_flags -o "\"$output_dir\""

# Kernel command line from the project (kernel.cmdline / kernel.cmdline_extra,
# exported by avocado-cli as AVOCADO_KERNEL_CMDLINE / _EXTRA). The firmware
# hands U-Boot and the kernel whatever bootfiles/cmdline.txt holds, on SD and
# NVMe alike, so compose it here from the BSP's copy. The result goes to the
# runtime's rekeyed/ dir, which stone searches before the runtime dir: the BSP's
# package-owned file is never written, and both provisioning and the OS bundle
# pick the composed one up. Removed when the project sets neither, so dropping
# cmdline_extra from avocado.yaml takes effect on the next build.
cmdline_src="$input_dir/bootfiles/cmdline.txt"
cmdline_dst="$input_dir/rekeyed/bootfiles/cmdline.txt"
rm -f "$cmdline_dst"
if [ -n "${AVOCADO_KERNEL_CMDLINE:-}${AVOCADO_KERNEL_CMDLINE_EXTRA:-}" ]; then
    if [ -n "${AVOCADO_KERNEL_CMDLINE:-}" ]; then
        cmdline="$AVOCADO_KERNEL_CMDLINE"
    elif [ -f "$cmdline_src" ]; then
        cmdline=$(tr '\n' ' ' < "$cmdline_src" | sed 's/[[:space:]]*$//')
    else
        echo "[ERROR] $cmdline_src not found: cannot append kernel.cmdline_extra" >&2
        exit 1
    fi
    [ -z "${AVOCADO_KERNEL_CMDLINE_EXTRA:-}" ] || cmdline="$cmdline $AVOCADO_KERNEL_CMDLINE_EXTRA"
    mkdir -p "$(dirname "$cmdline_dst")"
    printf '%s\n' "$cmdline" > "$cmdline_dst"
    echo -e "\033[94m[INFO]\033[0m Kernel command line from project config: $cmdline"
fi

# Kernel: the lockfile-pinned kernel (AVOCADO_KERNEL_IMAGE, exported by
# avocado-cli), not the Image the bootfiles package carries. The bootfiles copy
# is the build's default kernel, so a project pinned to another kernel (6.6 on a
# 6.12-default feed) booted the default while its rootfs held the pinned
# kernel's modules: no modular driver loaded and nothing said why. Staged into
# rekeyed/ like the cmdline, which stone searches first. Fail closed: boot and
# modules disagreeing is worse than not building.
kernel_dst="$input_dir/rekeyed/Image"
rm -f "$kernel_dst"
if [ -z "${AVOCADO_KERNEL_IMAGE:-}" ]; then
    echo "[ERROR] AVOCADO_KERNEL_IMAGE not set: needs an avocado-cli that exports the pinned kernel to build hooks" >&2
    exit 1
fi
if [ ! -f "$AVOCADO_KERNEL_IMAGE" ]; then
    echo "[ERROR] pinned kernel $AVOCADO_KERNEL_IMAGE does not exist; run 'avocado install'" >&2
    exit 1
fi
mkdir -p "$(dirname "$kernel_dst")"
cp -f "$AVOCADO_KERNEL_IMAGE" "$kernel_dst"
echo -e "\033[94m[INFO]\033[0m Kernel from the project's pin: $AVOCADO_KERNEL_IMAGE"

# Device trees and overlays from the same pin. The kernel image package pulls
# in its kernel-devicetree, which installs them flat into the rootfs /boot next
# to the Image the CLI staged from; the bootfiles copies are the default
# kernel's, and a 6.6 kernel rejects the 6.12 trees (PCIe fails to probe, so
# RP1 and everything behind it is gone).
dtb_src="$AVOCADO_PREFIX/rootfs/boot"
rm -f "$input_dir"/rekeyed/*.dtb "$input_dir"/rekeyed/*.dtbo
n=0
for f in "$dtb_src"/*.dtb "$dtb_src"/*.dtbo; do
    [ -f "$f" ] || continue
    cp -f "$f" "$input_dir/rekeyed/"
    n=$((n + 1))
done
if [ "$n" -eq 0 ]; then
    echo "[ERROR] no device trees in $dtb_src for the pinned kernel; is its kernel-devicetree installed?" >&2
    exit 1
fi
echo -e "\033[94m[INFO]\033[0m Device trees from the project's pin: $n files"

echo -e "\033[92m[SUCCESS]\033[0m Successfully ran SDK lifecycle hook '$hook' for target '$target'."
exit 0
