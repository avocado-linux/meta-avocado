# stock fstab - you probably want to override this with a machine specific one

# The rootfs image is read-only (erofs/squashfs) and, under rootfs dm-verity,
# /dev/root is a verity mapping that refuses a read-write remount outright -
# "defaults" here made systemd-remount-fs try exactly that and fail every boot.
# No fsck either: there is nothing to check and no writable superblock.
/dev/root            /                    auto       ro                    0  0
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
@AVOCADO_VAR_PART_DEV@  /var                 auto       defaults,x-systemd.growfs  0  0

# uncomment this if your device has a SD/MMC/Transflash slot
#/dev/mmcblk0p1       /media/card          auto       defaults,sync,noauto  0  0
