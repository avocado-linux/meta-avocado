From 2fc734f68249337b5379d10eb97cb3077eba1380 Mon Sep 17 00:00:00 2001
From: Justin Schneck <justin@peridio.com>
Date: Mon, 26 Jan 2026 18:33:46 -0500
Subject: [PATCH] rust: add v2 allocator symbols for Rust 1.89+

Rust 1.89+ introduced new allocator symbols with a _v2 suffix that are
required when using newer Rust toolchains. This patch adds the required
symbol definitions to lib.rs to enable building Chromium with Rust 1.89
and later.

The new symbols are:
- __rust_no_alloc_shim_is_unstable_v2
- __rust_alloc_error_handler_should_panic_v2

These symbols use the #[rustc_std_internal_symbol] attribute to match
the Rust ABI mangling scheme used in newer compiler versions.

Upstream-Status: Pending
---
 build/rust/allocator/lib.rs | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/build/rust/allocator/lib.rs b/build/rust/allocator/lib.rs
index c49d4249..9d9c67f9 100644
--- a/build/rust/allocator/lib.rs
+++ b/build/rust/allocator/lib.rs
@@ -105,4 +105,17 @@ mod both_allocators {
         // (Not really _needed_, but it could simplify code a little bit.)
         unsafe { ffi::alloc_error_handler_impl() }
     }
+
+    // Rust 1.89+ uses new symbol names with a _v2 suffix and __rustc namespace.
+    // These are required when using newer Rust toolchains with updated symbol
+    // mangling for allocator functions.
+    #[rustc_std_internal_symbol]
+    #[allow(non_upper_case_globals)]
+    #[linkage = "weak"]
+    static __rust_no_alloc_shim_is_unstable_v2: u8 = 0;
+
+    #[rustc_std_internal_symbol]
+    #[allow(non_upper_case_globals)]
+    #[linkage = "weak"]
+    static __rust_alloc_error_handler_should_panic_v2: u8 = 0;
 }
