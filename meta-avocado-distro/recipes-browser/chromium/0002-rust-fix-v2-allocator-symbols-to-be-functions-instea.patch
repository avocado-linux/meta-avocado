From 96aa1cc9531a612d57ab23db18f205f63990382d Mon Sep 17 00:00:00 2001
From: Beniamin Sandu <b.sandu@peridio.com>
Date: Thu, 2 Apr 2026 12:31:42 +0300
Subject: [PATCH] rust: fix v2 allocator symbols to be functions instead of
 statics

Backport from upstream Chromium (main branch). Rust 1.89+ introduced
new allocator symbols with a _v2 suffix (__rust_no_alloc_shim_is_unstable_v2,
__rust_alloc_error_handler_should_panic_v2). These must be defined as
functions, not static data, because the Rust 1.90+ compiler emits
R_AARCH64_CALL26 (branch-with-link) relocations to them before every
heap allocation. Defining them as static u8 places them in .rodata,
causing every Rust allocation to jump to read-only data and SIGSEGV.

Signed-off-by: Beniamin Sandu <b.sandu@peridio.com>
---
 build/rust/allocator/lib.rs | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/build/rust/allocator/lib.rs b/build/rust/allocator/lib.rs
index c49d424922..195b54163d 100644
--- a/build/rust/allocator/lib.rs
+++ b/build/rust/allocator/lib.rs
@@ -105,4 +105,17 @@ mod both_allocators {
         // (Not really _needed_, but it could simplify code a little bit.)
         unsafe { ffi::alloc_error_handler_impl() }
     }
+
+    // Rust 1.89+ uses new symbol names with a _v2 suffix and __rustc
+    // namespace. These must be functions, not statics, because the compiler
+    // emits call instructions to them before every heap allocation.
+    #[rustc_std_internal_symbol]
+    #[linkage = "weak"]
+    fn __rust_no_alloc_shim_is_unstable_v2() {}
+
+    #[rustc_std_internal_symbol]
+    #[linkage = "weak"]
+    fn __rust_alloc_error_handler_should_panic_v2() -> u8 {
+        0
+    }
 }
-- 
