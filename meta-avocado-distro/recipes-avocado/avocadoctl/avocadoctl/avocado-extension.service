[Unit]
Description=Avocado merge extensions

# Not in the initrd: avocado-extension-initrd.service covers that. Running both
# there races the two merges, and this unit's ordering before udev's coldplug
# trigger below assumes the real root, where /var is already mounted.
ConditionPathExists=!/etc/initrd-release
ConditionDirectoryNotEmpty=|/var/lib/avocado
ConditionCapability=CAP_SYS_ADMIN

DefaultDependencies=no
Requires=avocadoctl.socket
After=local-fs.target avocadoctl.socket
Before=sysinit.target systemd-tmpfiles-setup.service systemd-userdb-load-credentials.service
# Services that read /usr/lib and /etc configuration once, at start-up, must
# start after the merge, or they never see what an extension ships: sysctl.d,
# .network/.netdev/.link, resolved.conf.d and .dnssd. All three are
# DefaultDependencies=no, so Before=sysinit.target alone does not order them.
# Before= on a unit that is not installed is a no-op.
#
# Not systemd-udev-trigger: this unit waits for local-fs.target, whose devices
# (the /var partition, zram) only appear once coldplug has run, so ordering
# coldplug after the merge hangs boot until the device jobs time out.
Before=systemd-sysctl.service systemd-networkd.service systemd-resolved.service
Conflicts=shutdown.target initrd-switch-root.target
Before=shutdown.target initrd-switch-root.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
ExecStart=avocadoctl refresh
ExecReload=avocadoctl refresh
ExecStop=-avocadoctl unmerge

[Install]
WantedBy=sysinit.target
