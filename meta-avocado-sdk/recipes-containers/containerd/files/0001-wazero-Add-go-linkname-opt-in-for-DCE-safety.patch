From 9a83e08714053ec399fc2cc89d4e6a415ce6ce44 Mon Sep 17 00:00:00 2001
From: Avocado Linux <avocado@avocadolinux.org>
Date: Tue, 28 Apr 2026 22:08:59 -0400
Subject: [PATCH] wazero: keep asm entrypoints alive across cross-package
 linkname

Go 1.23+ requires the receiving side of a cross-package //go:linkname
reference to opt in with a matching //go:linkname directive, otherwise
the linker rejects the reference (with -checklinkname=1) and/or its
dead-code eliminator drops the asm-defined symbol (regardless of
-checklinkname).

The wazevo engine package wires its `entrypoint` and
`afterGoFunctionCallEntrypoint` stubs to asm symbols in a peer package
(backend/isa/{amd64,arm64}) via cross-package //go:linkname. Without
the receiving-side opt-in AND a forced liveness reference, the asm
symbols are dropped from the final binary and the external linker
fails with "undefined reference to ...amd64.entrypoint".

The fix:
  1. Add `//go:linkname` (no target) on the receiving side, declaring
     the symbol may be the target of external linkname references.
  2. Add `var _ = entrypoint` style references in the same package to
     force the symbol to be retained by liveness analysis across the
     cross-package link boundary.

Apply this in both nativesdk-containerd and nativesdk-docker since
both vendor the same wazero.

Upstream-Status: Pending [should be submitted to wazero upstream]
Signed-off-by: Avocado Linux <distro@avocadolinux.org>
---
 .../engine/wazevo/backend/isa/amd64/abi_entry_amd64.go      | 11 +++++++++++
 .../engine/wazevo/backend/isa/arm64/abi_entry_arm64.go      | 11 +++++++++++
 2 files changed, 22 insertions(+)

diff --git a/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/amd64/abi_entry_amd64.go b/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/amd64/abi_entry_amd64.go
--- a/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/amd64/abi_entry_amd64.go
+++ b/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/amd64/abi_entry_amd64.go
@@ -1,9 +1,20 @@
 package amd64

+import _ "unsafe"
+
 // entrypoint enters the machine code generated by this backend which begins with the preamble generated by functionABI.EmitGoEntryPreamble below.
 // This implements wazevo.entrypoint, and see the comments there for detail.
+//
+//go:linkname entrypoint
 func entrypoint(preambleExecutable, functionExecutable *byte, executionContextPtr uintptr, moduleContextPtr *byte, paramResultPtr *uint64, goAllocatedStackSlicePtr uintptr)

 // afterGoFunctionCallEntrypoint enters the machine code after growing the stack.
 // This implements wazevo.afterGoFunctionCallEntrypoint, and see the comments there for detail.
+//
+//go:linkname afterGoFunctionCallEntrypoint
 func afterGoFunctionCallEntrypoint(executable *byte, executionContextPtr uintptr, stackPointer, framePointer uintptr)
+
+// Force the linker to keep these asm-defined symbols alive across the
+// cross-package //go:linkname boundary in wazevo/entrypoint_amd64.go.
+var _ = entrypoint
+var _ = afterGoFunctionCallEntrypoint
diff --git a/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/arm64/abi_entry_arm64.go b/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/arm64/abi_entry_arm64.go
--- a/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/arm64/abi_entry_arm64.go
+++ b/vendor/github.com/tetratelabs/wazero/internal/engine/wazevo/backend/isa/arm64/abi_entry_arm64.go
@@ -1,9 +1,20 @@
 package arm64

+import _ "unsafe"
+
 // entrypoint enters the machine code generated by this backend which begins with the preamble generated by functionABI.EmitGoEntryPreamble below.
 // This implements wazevo.entrypoint, and see the comments there for detail.
+//
+//go:linkname entrypoint
 func entrypoint(preambleExecutable, functionExecutable *byte, executionContextPtr uintptr, moduleContextPtr *byte, paramResultPtr *uint64, goAllocatedStackSlicePtr uintptr)

 // afterGoFunctionCallEntrypoint enters the machine code after growing the stack.
 // This implements wazevo.afterGoFunctionCallEntrypoint, and see the comments there for detail.
+//
+//go:linkname afterGoFunctionCallEntrypoint
 func afterGoFunctionCallEntrypoint(executable *byte, executionContextPtr uintptr, stackPointer, framePointer uintptr)
+
+// Force the linker to keep these asm-defined symbols alive across the
+// cross-package //go:linkname boundary in wazevo/entrypoint_arm64.go.
+var _ = entrypoint
+var _ = afterGoFunctionCallEntrypoint
--
2.53.0

