# fw_printenv / fw_setenv: the U-Boot environment in the eMMC's user area,
# before the first partition. Offsets: u-boot/avocado-env-mmc.cfg and the
# stone manifest's uboot-env entry. The eMMC is mmcblk0 whatever disk the OS
# booted from (its controller probes first).
# Device name	Device offset	Env. size
/dev/mmcblk0	0x80000	0x20000
/dev/mmcblk0	0xA0000	0x20000
