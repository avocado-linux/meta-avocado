# The Avocado boot flow, compiled into U-Boot's default environment
# (CONFIG_ENV_SOURCE_FILE="avocado": u-boot_%.bbappend installs this file as
# board/solidrun/rzv2n/avocado.env with comment and blank lines removed, which
# U-Boot's env2string does not drop on its own). Only the slot state comes from
# the saved environment (env/avocado-rzv2n-sr-som.txt, permit list in
# 0003-*.patch), so this flow ships in the FIP and is updated with it.
#
# boot-a/boot-b/rootfs-a/rootfs-b are GPT partitions 1-4 of the OS disk: the
# eMMC (mmc 0) when it carries an OS, else the microSD (mmc 1). Both boot
# partitions carry the same extlinux/extlinux.conf, whose append says
# root=PARTUUID=${avocado_root_partuuid} (U-Boot expands it), so the slot picks
# the kernel partition and the root. The environment stays in the eMMC (it is
# on the SOM) whichever disk holds the OS.
avocado_boot_slot=a

# Load addresses (scriptaddr, kernel_addr_r, ...) come from SolidRun's
# CFG_EXTRA_ENV_SETTINGS, which stays in the same default environment.

# The OS disk, in devnum. The slot state belongs to one disk, named by its GPT
# disk GUID in avocado_boot_disk: a disk that does not match (a fresh
# provision, or the microSD after the eMMC was cleared) starts from slot A
# with no boot count, so a previous disk's slot never applies to it.
avocado_os_disk=\
  if part uuid mmc 0:3 avocado_root_partuuid; then\
    setenv devnum 0;\
  elif part uuid mmc 1:3 avocado_root_partuuid; then\
    setenv devnum 1;\
    echo "avocado: booting the microSD";\
  else\
    setenv devnum;\
    echo "avocado: no OS on the eMMC or the microSD";\
  fi;\
  if test -n "${devnum}" && gpt guid mmc ${devnum} avocado_disk_guid; then\
    if test "${avocado_disk_guid}" != "${avocado_boot_disk}"; then\
      echo "avocado: new OS disk ${avocado_disk_guid}, slot A";\
      setenv avocado_boot_disk ${avocado_disk_guid};\
      setenv avocado_boot_slot a;\
      setenv avocado_boot_tries;\
      saveenv;\
    fi;\
  fi;\
  true;

# Boot counting for a freshly activated slot. avocadoctl's activate sets
# avocado_boot_tries=3 with the new slot and its commit clears it once the new
# OS verifies. A try is spent when an OS boot is attempted (avocado_boot, just
# before sysboot), so a boot-chain update's reset costs none; a slot whose
# three OS boots never commit is abandoned here, before any userspace exists
# to roll it back.
avocado_bootcount=\
  if test -n "${avocado_boot_tries}" && test "${avocado_boot_tries}" -le 0; then\
    echo "avocado: slot ${avocado_boot_slot} never committed, rolling back";\
    if test "${avocado_boot_slot}" = "b"; then\
      setenv avocado_boot_slot a;\
    else\
      setenv avocado_boot_slot b;\
    fi;\
    setenv avocado_boot_tries;\
    saveenv;\
  fi;\
  true;

avocado_boot_init=\
  if test "${avocado_boot_slot}" = "b"; then\
    echo "Booting B";\
    setenv bootpart 2;\
    setenv rootpart 4;\
  else\
    if test "${avocado_boot_slot}" != "a"; then\
      echo "avocado_boot_slot=${avocado_boot_slot} unset or invalid";\
      setenv avocado_boot_slot a;\
    fi;\
    echo "Booting A";\
    setenv bootpart 1;\
    setenv rootpart 3;\
  fi;

# The OS disk in the selected slot, spending one of its tries. sysboot only
# returns on failure.
avocado_boot=\
  if test -n "${devnum}" && part uuid mmc ${devnum}:${rootpart} avocado_root_partuuid; then\
    if test -n "${avocado_boot_tries}"; then\
      setexpr avocado_boot_tries ${avocado_boot_tries} - 1;\
      saveenv;\
    fi;\
    sysboot mmc ${devnum}:${bootpart} any ${scriptaddr} /extlinux/extlinux.conf;\
  fi;\
  true;

# The boot chain follows the slot. Each boot partition carries the FIP (BL31 +
# U-Boot) its OS was built with, at /bootchain/fip.bin; before booting a slot,
# U-Boot compares it with the SPI NOR copy (offset 0x60000, where BL2 loads
# it) and rewrites SPI and resets when they differ. An OTA that ships a new
# FIP applies it on the first boot of the new slot, and a rollback puts the
# old slot's FIP back. The reset follows only a write that reads back equal,
# so a write that doesn't take can't reset the board in a loop: the boot goes
# on with the boot chain in SPI, and the next boot tries the write again. BL2 (SPI offset 0) is not updated over the air: a
# failed BL2 write leaves the board for the SCIF download recovery (the
# serial provision profile). A failed FIP write is the same single-copy risk.
avocado_fip_offset=0x60000
avocado_fip_max=0x180000
avocado_bootchain=\
  if test -n "${devnum}" && load mmc ${devnum}:${bootpart} ${loadaddr} /bootchain/fip.bin; then\
    setenv avocado_fip_size ${filesize};\
    if test 0x${avocado_fip_size} -gt ${avocado_fip_max}; then\
      echo "avocado: /bootchain/fip.bin is larger than the SPI FIP region, not applied";\
    elif sf probe; then\
      sf read ${kernel_addr_r} ${avocado_fip_offset} ${avocado_fip_size};\
      if cmp.b ${loadaddr} ${kernel_addr_r} ${avocado_fip_size}; then\
        true;\
      else\
        echo "avocado: updating the SPI boot chain (FIP) from slot ${avocado_boot_slot}";\
        if sf update ${loadaddr} ${avocado_fip_offset} ${avocado_fip_size} &&\
           sf read ${kernel_addr_r} ${avocado_fip_offset} ${avocado_fip_size} &&\
           cmp.b ${loadaddr} ${kernel_addr_r} ${avocado_fip_size}; then\
          reset;\
        fi;\
        echo "avocado: the SPI boot chain does not match slot ${avocado_boot_slot}, booting on";\
      fi;\
    fi;\
  fi;\
  true;

bootcmd=run avocado_os_disk avocado_bootcount avocado_boot_init avocado_bootchain avocado_boot; fastboot usb 0
