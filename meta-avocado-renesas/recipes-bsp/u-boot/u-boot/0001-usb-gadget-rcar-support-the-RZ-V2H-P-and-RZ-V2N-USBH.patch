diff --git a/drivers/usb/gadget/rcar/rzv2h.c b/drivers/usb/gadget/rcar/rzv2h.c
new file mode 100644
index 00000000000..6609c7107f4
--- /dev/null
+++ b/drivers/usb/gadget/rcar/rzv2h.c
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * RZ/V2H(P) and RZ/V2N USB2.0 channel 0 bring-up for the USBHS gadget.
+ *
+ * U-Boot's CPG driver for these SoCs does not gate clocks or resets, so the
+ * clocks, module stops and resets of the USB2.0 block are released here,
+ * then the USB2PHY control block is initialised as Linux'
+ * reset-rzv2h-usb2phy and mux-rzv2h-usb-vbenctl drivers do.
+ */
+
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <asm/io.h>
+#include <log.h>
+#include "rzv2h.h"
+
+#define CPG_BASE		0x10420000
+#define CPG_CLKON(i)		(CPG_BASE + 0x600 + (i) * 4)
+#define CPG_RST(i)		(CPG_BASE + 0x900 + (i) * 4)
+#define CPG_RSTMON(i)		(CPG_BASE + 0xa00 + (i) * 4)
+#define CPG_BUS_MSTOP(m)	(CPG_BASE + 0xd00 + ((m) - 1) * 4)
+
+/* usb2_0_u2h0_hclk, usb2_0_u2p_exr_cpuclk, usb2_0_pclk_usbtst0 */
+#define USB2_CLKON_IDX		11
+#define USB2_CLKON_BITS		(BIT(3) | BIT(5) | BIT(6))
+/* their bus master stops */
+#define USB2_MSTOP_IDX		7
+#define USB2_MSTOP_BITS		(BIT(7) | BIT(9) | BIT(10))
+/* USB2_0_U2H0_HRESETN, USB2_0_U2P_EXL_SYSRST, USB2_0_PRESETN */
+#define USB2_RST_IDX		10
+#define USB2_RST_BITS		(BIT(12) | BIT(14) | BIT(15))
+#define USB2_RSTMON4_BITS	(BIT(29) | BIT(31))
+#define USB2_RSTMON5_BITS	BIT(0)
+
+/* USB2PHY control (usb20phy-reset@15830000) */
+#define USB2PHY_CTRL_BASE	0x15830000
+#define USB2PHY_RESET		0x000
+#define USB2PHY_RESET2		0xb04
+#define USB2PHY_VBENCTL		0xf0c
+
+static const struct { u16 reg; u16 val; } usb2phy_init_vals[] = {
+	{ 0xc10, 0x67c },
+	{ 0xc14, 0x1f },
+	{ 0x600, 0x909 },
+};
+
+int usbhs_rzv2h_lowlevel_init(void)
+{
+	void __iomem *phyctrl = (void __iomem *)USB2PHY_CTRL_BASE;
+	unsigned int i;
+	u32 val;
+	int ret;
+
+	/* Clocks on (upper half: write enable), bus master stops released */
+	writel((USB2_CLKON_BITS << 16) | USB2_CLKON_BITS,
+	       (void __iomem *)CPG_CLKON(USB2_CLKON_IDX));
+	writel(USB2_MSTOP_BITS << 16, (void __iomem *)CPG_BUS_MSTOP(USB2_MSTOP_IDX));
+
+	/* Resets deasserted, then wait for the monitors to report it */
+	writel((USB2_RST_BITS << 16) | USB2_RST_BITS,
+	       (void __iomem *)CPG_RST(USB2_RST_IDX));
+	ret = readl_poll_timeout((void __iomem *)CPG_RSTMON(4), val,
+				 !(val & USB2_RSTMON4_BITS), 1000);
+	if (!ret)
+		ret = readl_poll_timeout((void __iomem *)CPG_RSTMON(5), val,
+					 !(val & USB2_RSTMON5_BITS), 1000);
+	if (ret) {
+		printf("usbhs: USB2.0 resets did not release\n");
+		return ret;
+	}
+
+	/* USB2PHY control: prepare, then release the PHY reset */
+	for (i = 0; i < ARRAY_SIZE(usb2phy_init_vals); i++)
+		writel(usb2phy_init_vals[i].val, phyctrl + usb2phy_init_vals[i].reg);
+	writel(0x200, phyctrl + USB2PHY_RESET);
+	writel(0x3, phyctrl + USB2PHY_RESET2);
+	writel(0x0, phyctrl + USB2PHY_RESET);
+
+	/* VBUS enable control: mux state 1, as the PHY's mux-states asks */
+	setbits_le32(phyctrl + USB2PHY_VBENCTL, BIT(0));
+
+	return 0;
+}
