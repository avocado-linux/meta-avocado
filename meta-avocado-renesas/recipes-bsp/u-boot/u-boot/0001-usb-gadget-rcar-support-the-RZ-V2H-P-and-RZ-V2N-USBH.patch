 /******* USB2.0 Host registers (original offset is +0x200) *******/
 #define USB2_INT_ENABLE		0x000
+#define USB2_REGEN_CG_CTRL	0x104	/* RZ/V2H(P) only */
+#define USB2_UTMI_CTRL		0x118	/* RZ/V2H(P) only */
 #define USB2_USBCTR		0x00c
 #define USB2_SPD_RSM_TIMSET	0x10c
 #define USB2_OC_TIMSET		0x110
@@ -100,10 +102,27 @@ static void rcar_gen3_set_linectrl(struct rcar_gen3_chan *ch, int dp, int dm)
 	writel(val, usb2_base + USB2_LINECTRL1);
 }
 
+/* RZ/V2H(P): no ADP block; VBUS is driven from VBCTRL, the ID pin is in LINECTRL1 */
+#define USB2_REGEN_CG_CTRL_UPHY_WEN	BIT(0)
+#define USB2_UTMI_CTRL_INIT		0x8000018f
+#define USB2_VBCTRL_VBOUT		BIT(0)
+#define USB2_OBINT_IDCHG_EN		BIT(0)
+
 static void rcar_gen3_enable_vbus_ctrl(struct rcar_gen3_chan *ch, int vbus)
 {
 	void __iomem *usb2_base = ch->usb2.base;
-	u32 val = readl(usb2_base + USB2_ADPCTRL);
+	u32 val;
+
+#if defined(USBHS_RZV2H)
+	val = readl(usb2_base + USB2_VBCTRL);
+	if (vbus)
+		val |= USB2_VBCTRL_VBOUT;
+	else
+		val &= ~USB2_VBCTRL_VBOUT;
+	writel(val, usb2_base + USB2_VBCTRL);
+	return;
+#endif
+	val = readl(usb2_base + USB2_ADPCTRL);
 
 	dev_vdbg(&ch->phy->dev, "%s: %08x, %d\n", __func__, val, vbus);
 	if (vbus)
@@ -161,7 +180,7 @@ static void rcar_gen3_device_recognition(struct rcar_gen3_chan *ch)
 	 * So the checking always return host mode.
 	 * We only use peripheral mode. So we just force
 	 * set is_host to false */
-#if defined(CONFIG_R9A07G044L) || defined(CONFIG_R9A07G044C) || defined(CONFIG_R9A07G043U) || defined(CONFIG_R9A07G054L) || defined(CONFIG_ARCH_RZMPU) || defined(CONFIG_R8A774C0)
+#if defined(CONFIG_R9A07G044L) || defined(CONFIG_R9A07G044C) || defined(CONFIG_R9A07G043U) || defined(CONFIG_R9A07G054L) || defined(CONFIG_ARCH_RZMPU) || defined(CONFIG_R8A774C0) || defined(USBHS_RZV2H)
 	is_host = false;
 #endif
 	if (is_host)
@@ -178,6 +197,19 @@ static void rcar_gen3_init_otg(struct rcar_gen3_chan *ch)
 
 	pr_dbg("++%s\n", __func__);
 
+#if defined(USBHS_RZV2H)
+	/* As Linux' phy-rcar-gen3-usb2 for no_adp_ctrl SoCs */
+	val = readl(usb2_base + USB2_LINECTRL1);
+	val = (val & ~USB2_LINECTRL1_DP_RPD) | USB2_LINECTRL1_DPRPD_EN |
+	      USB2_LINECTRL1_DMRPD_EN | USB2_LINECTRL1_DM_RPD;
+	writel(val, usb2_base + USB2_LINECTRL1);
+	mdelay(20);
+	writel(0xffffffff, usb2_base + USB2_OBINTSTA);
+	writel(USB2_OBINT_IDCHG_EN, usb2_base + USB2_OBINTEN);
+	rcar_gen3_device_recognition(ch);
+	pr_dbg("--%s\n", __func__);
+	return;
+#endif
 	val = readl(usb2_base + USB2_VBCTRL);
 	writel(val | USB2_VBCTRL_DRVVBUSSEL, usb2_base + USB2_VBCTRL);
 	writel(USB2_OBINT_BITS, usb2_base + USB2_OBINTSTA);
@@ -210,6 +242,18 @@ static int rcar_gen3_phy_usb2_init(struct phy *p)
 	if (channel->has_otg)
 		rcar_gen3_init_otg(channel);
 
+#if defined(USBHS_RZV2H)
+	{
+		u32 val = readl(usb2_base + USB2_REGEN_CG_CTRL) |
+			  USB2_REGEN_CG_CTRL_UPHY_WEN;
+
+		writel(val, usb2_base + USB2_REGEN_CG_CTRL);
+		writel(USB2_UTMI_CTRL_INIT, usb2_base + USB2_UTMI_CTRL);
+		writel(val & ~USB2_REGEN_CG_CTRL_UPHY_WEN,
+		       usb2_base + USB2_REGEN_CG_CTRL);
+	}
+#endif
+
 	pr_dbg("--%s\n", __func__);
 
 	return 0;
