#!/bin/sh
# avocado-uboot-env: write /run/avocado/fw_env.config for the disk this system
# booted from, so fw_printenv/fw_setenv (avocadoctl's slot detection and
# activation) reach the U-Boot environment U-Boot itself reads. The same image
# goes on the SD or the eMMC, so the device can't be fixed at build time.
#
# A config at /var/lib/avocado/fw_env.config wins (custom U-Boot builds).
# Offsets match recipes-bsp/u-boot/u-boot/avocado-env-mmc.cfg.

set -e

RUNTIME_CONFIG="/run/avocado/fw_env.config"
USER_OVERRIDE="/var/lib/avocado/fw_env.config"
ENV_OFFSET="0x1000000"
ENV_REDUND_OFFSET="0x1040000"
ENV_SIZE="0x20000"

mkdir -p /run/avocado

if [ -f "$USER_OVERRIDE" ]; then
    echo "avocado-uboot-env: using $USER_OVERRIDE"
    cp "$USER_OVERRIDE" "$RUNTIME_CONFIG"
    exit 0
fi

# The partition / is mounted from, then the disk that holds it.
part=$(findmnt -n -o SOURCE /)
disk=$(lsblk -n -d -o PKNAME "$part" 2>/dev/null || true)
if [ -z "$disk" ]; then
    echo "avocado-uboot-env: ERROR: no parent disk for / ($part)" >&2
    exit 1
fi

echo "avocado-uboot-env: boot disk is /dev/$disk"
cat > "$RUNTIME_CONFIG" <<EOT
# Generated by avocado-uboot-env for /dev/$disk (root on $part).
# To override, put your own config at $USER_OVERRIDE
/dev/$disk	$ENV_OFFSET	$ENV_SIZE
/dev/$disk	$ENV_REDUND_OFFSET	$ENV_SIZE
EOT
