#!/usr/bin/env bash

set -e

hook="avocado-build"
target="$AVOCADO_TARGET"

RUNTIME_NAME="$1"

output_dir="$AVOCADO_PREFIX/output/runtimes/$RUNTIME_NAME"

mkdir -p "$output_dir"

input_dir="$AVOCADO_PREFIX/runtimes/$RUNTIME_NAME"

# stone validate/create used to run here. avocado-cli commit 35124cb moved that
# work into the runtime build as `stone bundle`, which resolves the same inputs
# and additionally records the bundle hash in the runtime manifest. This hook is
# now the pre-bundle seam only: stage artifacts the manifest references that the
# generic pipeline cannot build, and let stone bundle consume them.

# kernel.cmdline / kernel.cmdline_extra from avocado.yaml go into the boot
# partition's extlinux.conf, so they travel with the boot slot through OTA.
# Regenerated on every build from the machine-named copy u-boot deploys
# (extlinux.conf itself may be a symlink to it, and must not be edited
# through), so repeated builds don't stack the extra args.
extlinux_src="$input_dir/extlinux.conf-avocado-${target}"
if [ -f "$extlinux_src" ]; then
    rm -f "$input_dir/extlinux.conf"
    awk -v line="${AVOCADO_KERNEL_CMDLINE:-}" -v extra="${AVOCADO_KERNEL_CMDLINE_EXTRA:-}" '
        /^[[:space:]]*APPEND / {
            if (line != "") { sub(/APPEND .*/, "APPEND " line) }
            if (extra != "") { $0 = $0 " " extra }
        }
        { print }
    ' "$extlinux_src" > "$input_dir/extlinux.conf"
    if [ -n "${AVOCADO_KERNEL_CMDLINE:-}${AVOCADO_KERNEL_CMDLINE_EXTRA:-}" ]; then
        echo "Kernel cmdline from project config: $(grep -m1 'APPEND' "$input_dir/extlinux.conf")"
    fi
fi

echo -e "\033[92m[SUCCESS]\033[0m Successfully ran SDK lifecycle hook '$hook' for target '$target'."
exit 0
