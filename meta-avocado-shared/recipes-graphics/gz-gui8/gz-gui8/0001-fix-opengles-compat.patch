From: Justin Schneck <j.schneck@peridio.com>
Date: Mon, 6 Oct 2025 01:24:34 -0400
Subject: [PATCH] fix opengles compat

---
 src/plugins/minimal_scene/EngineToQtInterface.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/plugins/minimal_scene/EngineToQtInterface.cc b/src/plugins/minimal_scene/EngineToQtInterface.cc
index 380f881f..f47d7ebf 100644
--- a/src/plugins/minimal_scene/EngineToQtInterface.cc
+++ b/src/plugins/minimal_scene/EngineToQtInterface.cc
@@ -23,6 +23,13 @@
 
 #include <QOpenGLExtraFunctions>
 
+// GL_UNSIGNED_INT_8_8_8_8_REV is not available in OpenGL ES
+// Define it if missing for compatibility with GLES platforms
+#ifndef GL_UNSIGNED_INT_8_8_8_8_REV
+// Use RGBA byte order format available in GLES
+#define GL_UNSIGNED_INT_8_8_8_8_REV 0x8367
+#endif
+
 // clang-format off
 namespace gz
 {
