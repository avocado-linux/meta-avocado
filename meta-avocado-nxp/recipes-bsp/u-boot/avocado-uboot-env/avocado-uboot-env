#!/bin/sh
# avocado-uboot-env: Generate /run/avocado/fw_env.config based on boot device.
#
# Priority:
#   1. User override at /var/lib/avocado/fw_env.config (for custom U-Boot builds)
#   2. Auto-detect from kernel cmdline root= parameter
#
# The U-Boot environment is stored at raw offsets on the boot MMC device:
#   Primary:   0x400000 (4 MiB)
#   Redundant: 0x440000 (4 MiB + 256 KiB)
#   Size:      0x20000  (128 KiB)

set -e

RUNTIME_CONFIG="/run/avocado/fw_env.config"
USER_OVERRIDE="/var/lib/avocado/fw_env.config"

# Standard offsets for avocado iMX U-Boot environment
ENV_OFFSET="0x400000"
ENV_REDUND_OFFSET="0x440000"
ENV_SIZE="0x20000"
SECTOR_SIZE="0x200"
SECTOR_COUNT="256"

mkdir -p /run/avocado

# Check for user-provided override first
if [ -f "$USER_OVERRIDE" ]; then
    echo "avocado-uboot-env: using user override from $USER_OVERRIDE"
    cp "$USER_OVERRIDE" "$RUNTIME_CONFIG"
    exit 0
fi

# Auto-detect boot device from kernel cmdline
root_dev=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=/dev/mmcblk*)
            root_dev="${arg#root=}"
            ;;
    esac
done

if [ -z "$root_dev" ]; then
    echo "avocado-uboot-env: ERROR: could not determine boot device from /proc/cmdline" >&2
    exit 1
fi

# Extract mmcblk device number (e.g., /dev/mmcblk0p6 -> 0, /dev/mmcblk1p7 -> 1)
mmc_dev=$(echo "$root_dev" | sed 's|/dev/mmcblk\([0-9]*\).*|\1|')

if [ -z "$mmc_dev" ]; then
    echo "avocado-uboot-env: ERROR: could not parse MMC device number from $root_dev" >&2
    exit 1
fi

echo "avocado-uboot-env: boot device is /dev/mmcblk${mmc_dev}"

cat > "$RUNTIME_CONFIG" << EOF
# Auto-generated by avocado-uboot-env from boot device mmcblk${mmc_dev}
# To override, place your own config at $USER_OVERRIDE
/dev/mmcblk${mmc_dev}	${ENV_OFFSET}	${ENV_SIZE}	${SECTOR_SIZE}	${SECTOR_COUNT}
/dev/mmcblk${mmc_dev}	${ENV_REDUND_OFFSET}	${ENV_SIZE}	${SECTOR_SIZE}	${SECTOR_COUNT}
EOF

echo "avocado-uboot-env: wrote $RUNTIME_CONFIG"
