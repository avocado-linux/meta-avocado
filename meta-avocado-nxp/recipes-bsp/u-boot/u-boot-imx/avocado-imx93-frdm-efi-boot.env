/*
 * EFI boot path for avocado-imx93-frdm - DEMO SCAFFOLDING, boot-integrity-demo only.
 *
 * Appended to the compiled-in avocado.env, never replacing it. env2string.awk
 * accumulates into an awk associative array (vars[var] = env) and emits each key
 * once at END, so a variable redefined here overwrites the earlier definition and
 * only one copy reaches CONFIG_EXTRA_ENV_TEXT. Order is the whole mechanism: this
 * block must be concatenated AFTER the base environment.
 *
 * What this changes, and what it deliberately does not:
 *
 *   avocado_boot_init is NOT touched. Slot selection stays exactly where it is -
 *   it sets bootpart, rootdev and bootargs, and fwup, avocadoctl and the stone
 *   manifest all drive it through avocado_boot_slot. Moving slot selection onto
 *   efibootmgr (as the x86-64 and qemux86-64 targets do, because they have no
 *   U-Boot to make the decision) would put a second selector next to a first one
 *   that is not going away.
 *
 *   load_image is NOT touched either. It still loads ${image_file} from
 *   ${bootpart}; only the name of that file changes, so the slot the payload
 *   comes from is still whatever avocado_boot_init picked.
 *
 * bootargs is already set by avocado_boot_init and U-Boot passes it to the stub
 * as the EFI load options, so the kernel command line needs no second home here.
 *
 * The device tree is loaded from the ESP rather than passed as U-Boot's own
 * ${fdtcontroladdr}. U-Boot's control DTB on i.MX is a stripped variant carrying
 * u-boot.dtsi additions and fewer peripherals; it frequently boots Linux and is
 * not guaranteed to, and when it falls short it does so as a missing peripheral
 * at runtime rather than as a boot failure. @FDT_FILE@ is substituted from
 * FIT_CONF_DEFAULT_DTB at do_configure time, which is the same variable the FIT
 * path uses, so the two boot paths cannot drift onto different device trees.
 */

image_file=EFI/BOOT/BOOTAA64.EFI

fdt_file=@FDT_FILE@

load_devicetree=load ${devtype} ${devnum}:${bootpart} ${fdt_addr_r} ${fdt_file}

avocado_boot=bootefi ${image_addr} ${fdt_addr_r}

bootcmd=run avocado_boot_init load_image load_devicetree avocado_boot
