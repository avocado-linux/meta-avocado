#!/usr/bin/env bash

set -e

hook="avocado-build"
target="rubikpi3"

# Nothing to stage here. This hook used to unpack the UFS tarball, swap in the
# runtime-built rootfs and var, and repack it, then run stone validate/create.
# The UFS work moved to provision time in f5a7d5cc61: `ufs` is no longer an
# entry under storage_devices.rootdisk.images, it is the provisioning method,
# and stone/rubikpi3/stone-provision-ufs.sh does the untar/inject/repack. The
# stone pass moved into the runtime build as `stone bundle` (avocado-cli
# 35124cb), which calls this hook first as the pre-bundle seam. Left as it was,
# `jq -r .storage_devices.rootdisk.images.ufs` read null, the hook looked for a
# file named "null" and failed every rubikpi3 build.

echo -e "\033[92m[SUCCESS]\033[0m Successfully ran SDK lifecycle hook '$hook' for target '$target'."
exit 0
