#!/usr/bin/env bash

set -e

hook="avocado-build"
target="rubikpi3"

RUNTIME_NAME="$1"

output_dir="$AVOCADO_PREFIX/output/runtimes/$RUNTIME_NAME"

mkdir -p "$output_dir"

input_dir="$AVOCADO_PREFIX/runtimes/$RUNTIME_NAME"
output_dir="$AVOCADO_PREFIX/output/runtimes/$RUNTIME_NAME/stone"
manifest="${AVOCADO_STONE_MANIFEST:-$AVOCADO_SDK_PREFIX/stone/stone-${target}.json}"

# Build include path flags from AVOCADO_STONE_INCLUDE_PATHS
build_include_flags() {
    local main_input_dir="$1"
    local include_flags=""
    
    if [ -n "$AVOCADO_STONE_INCLUDE_PATHS" ]; then
        IFS=':' read -ra PATHS <<< "$AVOCADO_STONE_INCLUDE_PATHS"
        for path in "${PATHS[@]}"; do
            if [ -n "$path" ]; then
                include_flags="$include_flags -i \"$path\""
            fi
        done
    fi
    
    include_flags="$include_flags -i \"$main_input_dir\""
    echo "$include_flags"
}

# Build display string of all include paths
build_include_display() {
    local main_input_dir="$1"
    local display=""
    
    if [ -n "$AVOCADO_STONE_INCLUDE_PATHS" ]; then
        IFS=':' read -ra PATHS <<< "$AVOCADO_STONE_INCLUDE_PATHS"
        for path in "${PATHS[@]}"; do
            if [ -n "$path" ]; then
                display="${display}\n    - ${path}"
            fi
        done
    fi
    
    display="${display}\n    - ${main_input_dir}"
    echo -e "$display"
}

# Nothing to stage here. This hook used to unpack the UFS tarball, swap in the
# runtime-built rootfs and var, and repack it. That work moved to provision time
# in 2f84126c10: `ufs` is no longer an entry under storage_devices.rootdisk.images
# at all, it is the provisioning method (provision_default: "ufs"), and
# stone/rubikpi3/stone-provision-ufs.sh does the untar/inject/repack against
# AVOCADO_STONE_DATA_DIR.
#
# The old body could not simply be left in place once this hook was wired back
# up: `jq -r ....images.ufs` now returns null, so it looked for a file literally
# named "null", missed, and hit its `exit 1` - failing every rubikpi3 build. It
# had been inert since 35124cb orphaned the hook, which is why nothing noticed.

# stone validate/create used to run here. avocado-cli commit 35124cb moved that
# work into the runtime build as `stone bundle`, which resolves the same inputs
# and additionally records the bundle hash in the runtime manifest. This hook is
# now the pre-bundle seam only: stage artifacts the manifest references that the
# generic pipeline cannot build, and let stone bundle consume them.


# --- Rebuild the ESP so the boot path is an OTA artifact ---------------------
#
# What boots this board is a UKI inside efi.bin, and Yocto builds that UKI from
# the DEFAULT multiconfig's kernel -- so on a feed carrying more than one
# kernel it is simply the wrong one, and the rootfs ends up with a module tree
# that matches no running kernel.
#
# This used to be fixed in stone-provision-ufs.sh, which worked but made the
# boot path un-OTA-able: `stone bundle` only bundles what exists at build time,
# so a kernel or command-line change needed a physical reflash. Doing it here,
# before bundle, puts the rebuilt ESP in the manifest alongside rootfs and var
# -- deployable and uploadable like anything else.
#
# Only runs when the manifest declares images.efi, so it is a no-op for targets
# that have not opted in.
esp_image=$(jq -r '(.storage_devices.rootdisk.images.efi // empty) | if type == "object" then (.out // empty) else . end' "$manifest")
initramfs_name=$(jq -r '.storage_devices.rootdisk.images.initramfs // empty' "$manifest")
# Declared in object form so `stone validate` does not demand a file this hook
# has not written yet, so the name is under .out -- same as images.efi.
uki_artifact=$(jq -r '(.storage_devices.rootdisk.images.uki // empty) | if type == "object" then (.out // empty) else . end' "$manifest")
bootfiles_name=$(jq -r '.storage_devices.rootdisk.images.bootfiles // empty' "$manifest")

if [ -n "$esp_image" ]; then
    # The pinned kernel, as avocado-cli resolved it from the lockfile.
    #
    # Not globbed. Both $AVOCADO_PREFIX/kernel and $AVOCADO_PREFIX/rootfs/boot
    # accumulate an entry per kernel version ever installed, so on a
    # multi-kernel feed either glob is ambiguous and `head -1` silently prefers
    # the alphabetically first -- which for 6.18.37-<scm> versus
    # 6.18.37-rt-<scm> is the stock kernel. Observed doing exactly that: a
    # project pinning RT got a UKI built around stock, flashed a board whose
    # /lib/modules matched no running kernel, and lost every modular driver
    # (ethernet, wifi, thermal) with nothing in the logs pointing at the cause.
    #
    # AVOCADO_KERNEL_IMAGE is the lockfile pin, which is the same authority
    # that decided which kernel's modules went into the rootfs. Fail closed:
    # boot and modules disagreeing is worse than not building an ESP.
    if [ -z "${AVOCADO_KERNEL_IMAGE:-}" ]; then
        echo -e "\033[91m[ERROR]\033[0m AVOCADO_KERNEL_IMAGE not set by avocado-cli." >&2
        echo -e "        Needs a CLI that exports the lockfile-pinned kernel to build hooks." >&2
        exit 1
    fi
    if [ ! -f "$AVOCADO_KERNEL_IMAGE" ]; then
        echo -e "\033[91m[ERROR]\033[0m Pinned kernel $AVOCADO_KERNEL_IMAGE does not exist; run 'avocado install'." >&2
        exit 1
    fi
    KERNEL_IMAGE="$AVOCADO_KERNEL_IMAGE"
    KERNEL_VERSION_RESOLVED="${AVOCADO_KERNEL_VERSION:-$(basename "$(dirname "$KERNEL_IMAGE")")}"

    # The stub and the current ESP come out of the yocto-static bootfiles
    # bundle, which is the input to this whole flow.
    esp_work="$input_dir/esp-work"
    rm -rf "$esp_work"; mkdir -p "$esp_work"
    tar -xzf "$input_dir/$bootfiles_name" -C "$esp_work" --strip-components=1 \
        avocado-image-rootfs/efi.bin avocado-image-rootfs/linuxaa64.efi.stub

    kver="$KERNEL_VERSION_RESOLVED"
    stub="$esp_work/linuxaa64.efi.stub"
    esp_img="$esp_work/efi.bin"
    uki_path="EFI/Linux/${AVOCADO_BLS_ENTRY:-avocado-a}.efi"

    # Rebuild the UKI around the kernel this project pinned, into the runtime
    # input dir so `stone bundle` picks it up as a manifest artifact.
    #
    # What boots this board is the UKI in efi.bin, and efi.bin comes out of the
    # yocto-static bootfiles bundle -- where linux-avocado-qcom-uki built that UKI
    # from the DEFAULT multiconfig's Image. That was harmless while the feed
    # carried one kernel. It is not harmless with two: `kernel.version` decides
    # which kernel's MODULES land in the rootfs, the ESP independently decides
    # which kernel BOOTS, and when they disagree /lib/modules matches no running
    # kernel and nothing modular loads at all. On this board that takes out
    # ethernet (the NIC is USB-attached behind the Renesas PCIe USB3 bridge, so it
    # needs xhci-pci + xhci-pci-renesas + usbnet), wifi and rubikpi-thermal.
    #
    # avocado-cli hands us the pinned kernel directly, so rebuild the UKI here --
    # the same place the runtime-built rootfs and var already get injected.
    #
    # Assembled with the cross objcopy rather than ukify: ukify lives in oe-core's
    # systemd recipe, which has no nativesdk variant, and a UKI is just the stub
    # with .osrel/.cmdline/.uname/.initrd/.linux appended at ascending VMAs.
    #
    # .cmdline and .osrel are lifted from the UKI already in the ESP instead of
    # being restated here, so the Yocto build stays the single source of truth for
    # the kernel command line (root=, console=, KERNEL_CMDLINE_EXTRA).
    uki_path="EFI/Linux/${AVOCADO_BLS_ENTRY:-avocado-a}.efi"
    esp_img="$esp_work/efi.bin"

    if [ -z "${KERNEL_IMAGE:-}" ]; then
        echo "No KERNEL_IMAGE from avocado-cli; keeping the UKI from the bootfiles bundle" >&2
    elif [ ! -f "$KERNEL_IMAGE" ]; then
        echo "ERROR: pinned kernel $KERNEL_IMAGE does not exist" >&2
        exit 1
    elif [ ! -f "$esp_img" ]; then
        echo "ERROR: no ESP image at $esp_img" >&2
        exit 1
    else
        kver="${KERNEL_VERSION_RESOLVED:-unknown}"
        echo "Rebuilding the UKI around the pinned kernel $kver"

        # Cross objcopy/objdump. CROSS_COMPILE is exported by the SDK entrypoint;
        # fall back to the known SDK path so this also works if it is not.
        oc="${CROSS_COMPILE:-}objcopy"
        od="${CROSS_COMPILE:-}objdump"
        command -v "$oc" >/dev/null 2>&1 || {
            oc=$(echo "$AVOCADO_SDK_PREFIX"/usr/bin/*/[a-z]*-objcopy | cut -d' ' -f1)
            od=$(echo "$AVOCADO_SDK_PREFIX"/usr/bin/*/[a-z]*-objdump | cut -d' ' -f1)
        }
        [ -x "$oc" ] || command -v "$oc" >/dev/null 2>&1 || { echo "ERROR: no objcopy in the SDK" >&2; exit 1; }

        uki_dir="$input_dir/uki"
        rm -rf "$uki_dir"; mkdir -p "$uki_dir"

        # The entry Yocto shipped, whatever it called it: linux-avocado-qcom-uki
        # names it after the machine, and this hook renames it to the slot form.
        # Discovered rather than assumed so the two cannot drift apart.
        old_entry=$(mdir -b -i "$esp_img" ::/EFI/Linux 2>/dev/null \
            | sed -n 's#^::/EFI/Linux/##p' | grep -i '\.efi$' | head -1)
        [ -n "$old_entry" ] || {
            echo "ERROR: no UKI in ::/EFI/Linux of $esp_img" >&2; exit 1; }
        mcopy -i "$esp_img" "::/EFI/Linux/$old_entry" "$uki_dir/old.efi" || {
            echo "ERROR: could not read EFI/Linux/$old_entry out of $esp_img" >&2; exit 1; }

        # Reuse the Yocto-baked cmdline and os-release. Fail closed on an empty
        # cmdline: without root=/console= the board flashes and boots to nothing.
        "$oc" -O binary --only-section=.cmdline "$uki_dir/old.efi" "$uki_dir/cmdline" 2>/dev/null || true
        "$oc" -O binary --only-section=.osrel   "$uki_dir/old.efi" "$uki_dir/osrel"   2>/dev/null || true

        # Rebuild .osrel from the rootfs this UKI actually boots, and add the two
        # fields an OS update needs. The section carried over from the previous
        # UKI describes whatever rootfs THAT one booted, which is wrong the moment
        # the runtime changes.
        #
        #   IMAGE_VERSION  is what systemd-boot sorts entries by (its binary reads
        #                  IMAGE_VERSION, then VERSION_ID). Every avocado build
        #                  carries VERSION_ID=0.0.0 in a dev feed, so without this
        #                  every entry ties and ordering falls back to the entry
        #                  id -- which means a freshly installed update does NOT
        #                  sort ahead of the entry it replaces, and would only be
        #                  chosen by accident. Sorting is the whole selection
        #                  mechanism here: this board has no EFI variables (no
        #                  efivarfs at all), so a one-shot boot entry is not
        #                  available, and pinning `default` in loader.conf was
        #                  measured to override boot assessment completely -- an
        #                  entry with its tries exhausted (+0-3) was still chosen,
        #                  and booted, and incremented to +0-4. A pinned default
        #                  means no automatic recovery, so selection has to come
        #                  from the ordering, and the ordering has to be real.
        #
        #   AVOCADO_OS_BUILD_ID  lets the running system find the entry it booted
        #                  from, which is how the boot counter gets cleared on
        #                  success. systemd-bless-boot cannot do it here: it
        #                  learns the path from the LoaderBootCountPath EFI
        #                  variable, and there are none.
        rootfs_osrel="$AVOCADO_PREFIX/rootfs/usr/lib/os-release"
        if [ -f "$rootfs_osrel" ]; then
            grep -vE '^(IMAGE_VERSION|IMAGE_ID)=' "$rootfs_osrel" > "$uki_dir/osrel"
            # Monotonic, and ordered the way strverscmp orders: a build that
            # happens later must sort ahead of one that happened earlier, or an
            # update installs and is never selected. SOURCE_DATE_EPOCH when the
            # build set one, so a reproducible build stays reproducible.
            version_id=$(sed -n 's/^VERSION_ID=//p' "$rootfs_osrel" | tr -d '"')
            printf 'IMAGE_VERSION="%s+%s"\n' \
                "${version_id:-0}" "${SOURCE_DATE_EPOCH:-$(date -u +%s)}" \
                >> "$uki_dir/osrel"
        else
            echo "WARNING: no $rootfs_osrel; keeping the previous UKI's .osrel," >&2
            echo "         which leaves this entry unsortable against the one it replaces." >&2
        fi
        # .sbat carries the Secure Boot revocation generation. Dropping it silently
        # changes what the loader is willing to run, so it is carried across.
        "$oc" -O binary --only-section=.sbat    "$uki_dir/old.efi" "$uki_dir/sbat"    2>/dev/null || : > "$uki_dir/sbat"
        tr -d '\0' < "$uki_dir/cmdline" > "$uki_dir/cmdline.txt" 2>/dev/null || true
        # Amend the command line from the project, not from this layer.
        #
        # The base comes from the UKI already in the ESP, so the Yocto build stays
        # the source of truth for the board-specific parts it alone knows (root=,
        # console=, KERNEL_CMDLINE_EXTRA). Anything project-specific -- isolcpus,
        # nohz_full, earlycon, a custom console -- is composed on top from the
        # avocado side, so the BSP does not have to be rebuilt to change it and
        # nothing implementation-specific gets frozen into the image.
        #
        #   AVOCADO_KERNEL_CMDLINE        replace the line outright
        #   AVOCADO_KERNEL_CMDLINE_EXTRA  append to it
        #
        # Settable today with `avocado provision --env NAME=...`. These names match
        # the KERNEL_IMAGE / _VERSION pair avocado-cli already
        # exports, so a future `kernel.cmdline_extra` config field can export the
        # same variable and projects can declare it in avocado.yaml instead.
        if [ -n "${AVOCADO_KERNEL_CMDLINE:-}" ]; then
            printf '%s' "$AVOCADO_KERNEL_CMDLINE" > "$uki_dir/cmdline.txt"
            echo "Kernel cmdline replaced from project config"
        fi
        if [ -n "${AVOCADO_KERNEL_CMDLINE_EXTRA:-}" ]; then
            printf ' %s' "$AVOCADO_KERNEL_CMDLINE_EXTRA" >> "$uki_dir/cmdline.txt"
            echo "Kernel cmdline extended from project config: $AVOCADO_KERNEL_CMDLINE_EXTRA"
        fi
        [ -s "$uki_dir/cmdline.txt" ] || {
            echo "ERROR: no kernel command line recoverable from the existing UKI" >&2
            echo "       Building one without it yields a board that flashes and never boots." >&2
            exit 1; }
        [ -s "$uki_dir/osrel" ] || cp "$input_dir/os-release" "$uki_dir/osrel" 2>/dev/null || : > "$uki_dir/osrel"
        printf '%s' "$kver" > "$uki_dir/uname"
        echo "Kernel cmdline: $(cat "$uki_dir/cmdline.txt")"

        initramfs="$input_dir/$initramfs_name"
        [ -f "$initramfs" ] || initramfs="$input_dir/$initramfs_name"
        [ -f "$initramfs" ] || { echo "ERROR: initramfs $initramfs_name not staged" >&2; exit 1; }

        # Sections go after the stub's last one, each 4 KiB aligned.
        stub="$esp_work/linuxaa64.efi.stub"
        [ -f "$stub" ] || { echo "ERROR: no linuxaa64.efi.stub in the bootfiles bundle" >&2; exit 1; }
        # Assemble with ukify -- the same tool linux-avocado-qcom-uki uses during
        # the Yocto build, so the rebuilt UKI is produced exactly the way the
        # working one was. Comes from nativesdk-systemd-boot.
        #
        # Hand-assembling the PE was tried twice and is not worth it. objcopy
        # produces an image matching a known-good UKI on every axis objdump shows
        # and still cannot boot (UEFI takes an undefined-instruction exception,
        # ESR 0x2000000, during "OS Loader" -- reproduced with a kernel known to
        # boot, so it is the assembly). A pefile reimplementation landed within 5
        # bytes of ukify's output but still differed on SizeOfInitializedData and
        # marked .linux as initialized data rather than code.
        command -v ukify >/dev/null 2>&1 || {
            echo "ERROR: ukify not in the SDK (need nativesdk-systemd-boot)" >&2
            exit 1; }

        ukify build \
            --linux="$KERNEL_IMAGE" \
            --initrd="$initramfs" \
            --cmdline="@$uki_dir/cmdline.txt" \
            --os-release="@$uki_dir/osrel" \
            --uname="$kver" \
            --stub="$stub" \
            --efi-arch=aa64 \
            --output="$uki_dir/new.efi" || {
                echo "ERROR: ukify failed to build the UKI" >&2; exit 1; }

        mcopy -o -i "$esp_img" "$uki_dir/new.efi" "::/$uki_path" || {
            echo "ERROR: could not write the rebuilt UKI back into $esp_img" >&2; exit 1; }
        # Remove the entry this one replaces. Leaving it would ship an ESP with
        # two entries for the same generation, and the loader picks by version:
        # they would tie, and which one boots would come down to directory order.
        if [ "EFI/Linux/$old_entry" != "$uki_path" ]; then
            mdel -i "$esp_img" "::/EFI/Linux/$old_entry" || {
                echo "ERROR: could not remove superseded entry EFI/Linux/$old_entry" >&2
                exit 1; }
            echo "Replaced entry EFI/Linux/$old_entry with $uki_path"
        fi
        echo "ESP now boots $kver ($(stat -c %s "$uki_dir/new.efi") bytes)"
    fi

    # The UKI on its own, as an OTA artifact.
    #
    # Provisioning flashes the whole 600 MiB FAT image over QDL; an update has
    # no business rewriting a boot filesystem to change a 75 MB file inside it,
    # and could not do it safely anyway (there is one ESP on this board, so a
    # raw rewrite has no second copy to fall back to). The update ships the
    # entry alone and installs it alongside the running one, which is what makes
    # the loader's boot assessment able to fall back at all.
    if [ -n "${uki_artifact:-}" ] && [ -f "$uki_dir/new.efi" ]; then
        cp "$uki_dir/new.efi" "$input_dir/$uki_artifact"
        echo "Staged ${uki_artifact} ($(stat -c %s "$uki_dir/new.efi") bytes) as an OS update artifact."
    fi

    # Hand the rebuilt ESP to stone as the images.efi artifact.
    cp "$esp_img" "$input_dir/$esp_image"
    echo -e "\033[92m[SUCCESS]\033[0m Rebuilt ${esp_image} around kernel ${kver}; it is now a manifest artifact."
fi

echo -e "\033[92m[SUCCESS]\033[0m Successfully ran SDK lifecycle hook '$hook' for target '$target'."
exit 0
