{
  "runtime": {
    "platform": "avocado-rb3gen2",
    "architecture": "arm64",
    "provision_default": "ufs"
  },
  "provision": {
    "profiles": {
      "ufs": {
        "script": "stone-provision-ufs.sh"
      },
      "noop": {
        "script": "stone-provision-noop.sh"
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-image-rootfs-rb3gen2.bootfiles.tar.gz",
      "devpath": "/dev/disk/by-partlabel/system",
      "block_size": 512,
      "partitions": [],
      "images": {
        "bootfiles": "avocado-image-rootfs-rb3gen2.bootfiles.tar.gz",
        "rootfs": "avocado-image-rootfs-rb3gen2.erofs-lz4",
        "var": "avocado-image-var-rb3gen2.btrfs",
        "initramfs": "avocado-image-initramfs-rb3gen2.cpio.zst",
        "efi": {
          "out": "efi.bin",
          "size": 600,
          "size_unit": "mebibytes"
        },
        "uki_a": {
          "out": "uki_a.efi",
          "size": 128,
          "size_unit": "mebibytes"
        },
        "uki_b": {
          "out": "uki_b.efi",
          "size": 128,
          "size_unit": "mebibytes"
        }
      }
    }
  },
  "update": {
    "slot_detection": {
      "type": "command",
      "command": [
        "avocado-bls",
        "current-slot"
      ]
    },
    "os_artifacts": {
      "rootfs": {
        "image_key": "rootfs",
        "slot_partitions": [
          "system_a",
          "system_b"
        ]
      },
      "uki_a": {
        "image_key": "uki_a",
        "slot_partitions": [
          "file:efi:EFI/Linux/avocado-a+3.efi",
          "skip"
        ]
      },
      "uki_b": {
        "image_key": "uki_b",
        "slot_partitions": [
          "skip",
          "file:efi:EFI/Linux/avocado-b+3.efi"
        ]
      }
    },
    "activate": [],
    "commit": [
      {
        "type": "command",
        "command": [
          "avocado-bls",
          "bless"
        ]
      }
    ],
    "rollback": [
      {
        "type": "command",
        "command": [
          "avocado-bls",
          "demote",
          "{new_slot}"
        ]
      }
    ]
  }
}
