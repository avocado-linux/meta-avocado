#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Parse command line arguments
RUNTIME=""
MEMORY="1024"

while [[ $# -gt 0 ]]; do
    case $1 in
        --mem)
            MEMORY="$2"
            shift 2
            ;;
        -*)
            echo "Error: Unknown option $1"
            echo "Usage: $0 <runtime> [--mem MEMORY]"
            exit 1
            ;;
        *)
            if [ -z "$RUNTIME" ]; then
                RUNTIME="$1"
            else
                echo "Error: Multiple runtime arguments provided"
                echo "Usage: $0 <runtime> [--mem MEMORY]"
                exit 1
            fi
            shift
            ;;
    esac
done

# Check if runtime argument is provided
if [ -z "$RUNTIME" ]; then
    echo "Error: Runtime argument required"
    echo "Usage: $0 <runtime> [--mem MEMORY]"
    exit 1
fi

# Display runtime and flag arguments
echo "Runtime: ${RUNTIME}"
echo "Memory: ${MEMORY} MB"

# Check if this is a QEMU target
if [[ ! "$AVOCADO_SDK_TARGET" =~ qemu ]]; then
    echo "Error: This script can only be run for QEMU targets"
    echo "Current target: $AVOCADO_SDK_TARGET"
    exit 1
fi

# Extract architecture from AVOCADO_SDK_TARGET and determine QEMU binary, BIOS, and CPU
if [[ "$AVOCADO_SDK_TARGET" =~ x86-64$ ]]; then
    QEMU_ARCH="x86_64"
    QEMU_BINARY="qemu-system-x86_64"
    QEMU_BIOS_FILE="u-boot.rom"
    QEMU_CPU="max"
elif [[ "$AVOCADO_SDK_TARGET" =~ arm64$ ]]; then
    QEMU_ARCH="aarch64"
    QEMU_BINARY="qemu-system-aarch64"
    QEMU_BIOS_FILE="flash.bin"
    QEMU_CPU="cortex-a53"
else
    echo "Error: Unsupported architecture in AVOCADO_SDK_TARGET: $AVOCADO_SDK_TARGET"
    echo "Supported architectures: x86-64, arm64"
    exit 1
fi

# Set the Stone build directory
STONE_DATA_DIR="${AVOCADO_PREFIX}/output/runtimes/${RUNTIME}/stone"
STONE_BUILD_DIR="${STONE_DATA_DIR}/_build"

# Check if the image file exists
IMAGE_FILE="${STONE_BUILD_DIR}/avocado-${AVOCADO_SDK_TARGET}-rootdisk.img"
if [ ! -f "$IMAGE_FILE" ]; then
    echo "Error: Image file not found: $IMAGE_FILE"
    echo "Please build the image first using: avocado-build image"
    exit 1
fi

qemu-img resize -f raw "$IMAGE_FILE" 1024M

QEMU_BIOS="${STONE_DATA_DIR}/${QEMU_BIOS_FILE}"

"${QEMU_BINARY}" \
    -bios "${QEMU_BIOS}" \
    -device sdhci-pci \
    -device sd-card,drive=mmc \
    -drive file="${IMAGE_FILE}",if=none,format=raw,id=mmc \
    -m "${MEMORY}" \
    -cpu "${QEMU_CPU}" \
    -nographic
