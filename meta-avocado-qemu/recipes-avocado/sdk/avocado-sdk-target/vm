#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Parse command line arguments
RUNTIME=""
MEMORY="1024"
SMP="2"
ENABLE_KVM=false
HOST_FWD_ARGS=()
QGA_PORT=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --mem)
      MEMORY="$2"
      shift 2
      ;;
    --smp)
      SMP="$2"
      shift 2
      ;;
    --enable-kvm)
      ENABLE_KVM=true
      shift
      ;;
    --host-fwd)
      HOST_FWD_ARGS+=("$2")
      shift 2
      ;;
    --qga-port)
      QGA_PORT="$2"
      shift 2
      ;;
    -*)
      echo "Error: Unknown option $1"
      echo "Usage: $0 <runtime> [--mem MEMORY] [--smp SMP] [--enable-kvm] [--host-fwd HOST_PORT:GUEST_PORT]"
      exit 1
      ;;
    *)
      if [ -z "$RUNTIME" ]; then
        RUNTIME="$1"
      else
        echo "Error: Multiple runtime arguments provided"
        echo "Usage: $0 <runtime> [--mem MEMORY] [--smp SMP] [--enable-kvm] [--host-fwd HOST_PORT:GUEST_PORT]"
        exit 1
      fi
      shift
      ;;
  esac
done

# Check if runtime argument is provided
if [ -z "$RUNTIME" ]; then
  echo "Error: Runtime argument required"
  echo "Usage: $0 <runtime> [--mem MEMORY] [--smp SMP] [--enable-kvm] [--host-fwd HOST_PORT:GUEST_PORT]"
  exit 1
fi

# Display runtime and flag arguments
echo "Runtime: ${RUNTIME}"
echo "Memory: ${MEMORY} MB"
echo "SMP: ${SMP}"
echo "KVM Enabled: ${ENABLE_KVM}"
if [ ${#HOST_FWD_ARGS[@]} -gt 0 ]; then
  echo "Port Forwarding: ${HOST_FWD_ARGS[*]}"
fi

# Check if this is a QEMU target
if [[ ! "$AVOCADO_SDK_TARGET" =~ qemu ]]; then
  echo "Error: This script can only be run for QEMU targets"
  echo "Current target: $AVOCADO_SDK_TARGET"
  exit 1
fi

# Extract architecture from AVOCADO_SDK_TARGET and determine QEMU binary, BIOS, and CPU
if [[ "$AVOCADO_SDK_TARGET" =~ x86-64$ ]]; then
  QEMU_ARCH="x86_64"
  QEMU_BINARY="qemu-system-x86_64"
  # The image boots systemd-boot from its ESP, so the firmware is UEFI (OVMF)
  # from QEMU's own data dir rather than a file stone stages.
  QEMU_BIOS_FILE=""
  QEMU_CPU="max"
  QEMU_MACHINE=""
elif [[ "$AVOCADO_SDK_TARGET" =~ arm64$ ]]; then
  # Not consumed below (QEMU_BINARY already encodes the arch), but kept so
  # both branches of this mapping describe the target the same way.
  # shellcheck disable=SC2034
  QEMU_ARCH="aarch64"
  QEMU_BINARY="qemu-system-aarch64"
  QEMU_BIOS_FILE="flash.bin"
  QEMU_CPU="cortex-a53"
  QEMU_MACHINE="@QB_MACHINE@"
else
  echo "Error: Unsupported architecture in AVOCADO_SDK_TARGET: $AVOCADO_SDK_TARGET"
  echo "Supported architectures: x86-64, arm64"
  exit 1
fi

# Override CPU to 'host' if KVM is enabled
if [ "$ENABLE_KVM" = true ]; then
  QEMU_CPU="host"
fi

# Build hostfwd string from collected port mappings
HOSTFWD_STRING=""
if [ ${#HOST_FWD_ARGS[@]} -gt 0 ]; then
  for hostfwd in "${HOST_FWD_ARGS[@]}"; do
    if [ -z "$HOSTFWD_STRING" ]; then
      HOSTFWD_STRING="hostfwd=tcp::${hostfwd}"
    else
      HOSTFWD_STRING="${HOSTFWD_STRING},hostfwd=tcp::${hostfwd}"
    fi
  done
fi

# Set the Stone build directory
STONE_DATA_DIR="${AVOCADO_PREFIX}/output/runtimes/${RUNTIME}/stone"
STONE_BUILD_DIR="${STONE_DATA_DIR}/_build"

# The provision scripts name the image differently: qemuarm64's after the
# manifest's rootdisk out (avocado-os-qemuarm64.img), qemux86-64's after the
# platform (avocado-os-avocado-qemux86-64.img).
IMAGE_FILE=""
for name in "avocado-os-${AVOCADO_SDK_TARGET}.img" "avocado-os-avocado-${AVOCADO_SDK_TARGET}.img"; do
  if [ -f "${STONE_BUILD_DIR}/${name}" ]; then
    IMAGE_FILE="${STONE_BUILD_DIR}/${name}"
    break
  fi
done
if [ -z "$IMAGE_FILE" ]; then
  echo "Error: no avocado-os-${AVOCADO_SDK_TARGET}.img or avocado-os-avocado-${AVOCADO_SDK_TARGET}.img in ${STONE_BUILD_DIR}"
  echo "Please provision the runtime first: avocado provision ${RUNTIME}"
  exit 1
fi

# The commas below belong to QEMU's own option syntax (sd-card,drive=mmc and
# the -drive property list); they are not array element separators.
# shellcheck disable=SC2054
if [ -n "$QEMU_BIOS_FILE" ]; then
  # QEMU's sd-card device requires a power-of-two backing size, so pad the
  # image up to one: the smallest power-of-two MiB at least the image size,
  # with a 1 GiB floor. Never shrink: qemu-img refuses to shrink a raw image
  # without --shrink, which would abort here under set -e.
  image_bytes=$(stat -c %s "$IMAGE_FILE")
  resize_mib=1024
  while [ $((resize_mib * 1024 * 1024)) -lt "$image_bytes" ]; do
    resize_mib=$((resize_mib * 2))
  done
  if [ "$image_bytes" -ne $((resize_mib * 1024 * 1024)) ]; then
    qemu-img resize -f raw "$IMAGE_FILE" "${resize_mib}M"
  fi

  QEMU_ARGS=(
    -bios "${STONE_DATA_DIR}/${QEMU_BIOS_FILE}"
    -device sdhci-pci
    -device sd-card,drive=mmc
    -drive file="${IMAGE_FILE}",if=none,format=raw,id=mmc
  )
else
  # OVMF from the QEMU this SDK ships, beside its binary. The variable store is
  # a writable copy per image, kept across runs so the boot entries an A/B
  # update writes survive a restart. Delete it to start from empty variables.
  QEMU_DATA_DIR="$(dirname "$(command -v "$QEMU_BINARY")")/../share/qemu"
  OVMF_CODE="${QEMU_DATA_DIR}/edk2-x86_64-code.fd"
  OVMF_VARS="${IMAGE_FILE%.img}-efivars.fd"
  if [ ! -f "$OVMF_CODE" ]; then
    echo "Error: UEFI firmware not found: $OVMF_CODE"
    exit 1
  fi
  if [ ! -f "$OVMF_VARS" ]; then
    cp "${QEMU_DATA_DIR}/edk2-i386-vars.fd" "$OVMF_VARS"
  fi

  # The manifest's rootdisk is /dev/vda: a virtio disk.
  QEMU_ARGS=(
    -drive if=pflash,format=raw,readonly=on,file="${OVMF_CODE}"
    -drive if=pflash,format=raw,file="${OVMF_VARS}"
    -drive file="${IMAGE_FILE}",if=virtio,format=raw
  )
fi

QEMU_ARGS+=(
  -m "${MEMORY}"
  -smp "${SMP}"
  -cpu "${QEMU_CPU}"
  -nographic
)

# Add network arguments if port forwarding is configured
if [ -n "$HOSTFWD_STRING" ]; then
  QEMU_ARGS+=(-netdev "user,id=net0,$HOSTFWD_STRING")
  QEMU_ARGS+=(-device "e1000,netdev=net0")
fi

# Add machine type if specified
if [ -n "$QEMU_MACHINE" ]; then
  QEMU_ARGS+=(-machine "${QEMU_MACHINE}")
fi

# Add KVM flag if enabled
if [ "$ENABLE_KVM" = true ]; then
  QEMU_ARGS+=(-enable-kvm)
fi

# Add the QEMU guest agent channel (opt-in via --qga-port). Lets a host-side
# driver exec commands in the guest over org.qemu.guest_agent.0 without ssh. A
# TCP chardev is host-reachable because `avocado sdk run` uses --network=host,
# so the host connects to 127.0.0.1:${QGA_PORT}.
if [ -n "$QGA_PORT" ]; then
  # Commas here are QEMU chardev/device property separators, not array
  # element separators.
  # shellcheck disable=SC2054
  QEMU_ARGS+=(
    -chardev "socket,id=qga,host=127.0.0.1,port=${QGA_PORT},server=on,wait=off"
    -device virtio-serial
    -device virtserialport,chardev=qga,name=org.qemu.guest_agent.0
  )
fi

"${QEMU_BINARY}" "${QEMU_ARGS[@]}"
