{
  "runtime": {
    "platform": "avocado-qemux86-64",
    "architecture": "x86_64",
    "provision_default": "img",
    "update_strategy": "sdboot-ab"
  },
  "update": {
    "slot_detection": {
      "type": "sdboot-efi",
      "partitions": {
        "a2e0a8c1-0002-4b01-a000-0000000000a1": "a",
        "a2e0a8c1-0002-4b01-b000-0000000000b1": "b"
      }
    },
    "os_artifacts": {
      "boot": { "image_key": "boot", "slot_partitions": ["boot-a", "boot-b"] },
      "rootfs": { "image_key": "rootfs", "slot_partitions": ["rootfs-a", "rootfs-b"] }
    },
    "activate": {
      "type": "efibootmgr",
      "slot_entries": { "a": "boot-a", "b": "boot-b" }
    },
    "rollback": {
      "type": "efibootmgr",
      "slot_entries": { "a": "boot-a", "b": "boot-b" }
    }
  },
  "provision": {
    "envs": {
      "device_info": {
        "AVOCADO_DEVICE_CERT": "${AVOCADO_DEVICE_CERT}",
        "AVOCADO_DEVICE_KEY": "${AVOCADO_DEVICE_KEY}",
        "AVOCADO_DEVICE_ID": "${AVOCADO_DEVICE_ID}"
      },
      "cmdline": {
        "AVOCADO_CMDLINE_EXTRA": "${AVOCADO_CMDLINE_EXTRA}"
      }
    },
    "fields": {
      "AVOCADO_DEVICE_CERT": {
        "type": "file",
        "label": "Device certificate",
        "description": "X.509 device certificate in PEM format."
      },
      "AVOCADO_DEVICE_KEY": {
        "type": "file",
        "label": "Device private key",
        "description": "PEM-encoded private key paired with the device certificate.",
        "secret": true
      },
      "AVOCADO_DEVICE_ID": {
        "type": "string",
        "label": "Device ID",
        "description": "Stable identifier registered with Peridio."
      },
      "AVOCADO_CMDLINE_EXTRA": {
        "type": "multiline",
        "label": "Extra kernel command-line",
        "description": "Appended to the default kernel cmdline.",
        "required": false
      }
    },
    "profiles": {
      "img": {
        "script": "stone-provision-img.sh",
        "envs": ["device_info", "cmdline"]
      },
      "direct": {
        "script": "stone-provision-direct.sh",
        "envs": ["cmdline"]
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-os-qemux86-64",
      "devpath": "/dev/vda",
      "block_size": 512,
      "images": {
        "boot": {
          "out": "boot.img",
          "size": 256,
          "size_unit": "mebibytes",
          "build_args": {
            "type": "fat",
            "variant": "FAT32",
            "files": [
              { "in": "systemd-bootx64.efi", "out": "EFI/BOOT/BOOTX64.EFI" },
              { "in": "bzImage", "out": "bzImage" },
              { "in": "avocado-image-initramfs-qemux86-64.cpio.zst", "out": "initramfs.cpio.zst" },
              { "in": "loader.conf", "out": "loader/loader.conf" },
              { "in": "avocado.conf", "out": "loader/entries/avocado.conf" }
            ]
          }
        },
        "rootfs": "avocado-image-rootfs-qemux86-64.erofs-lz4",
        "var": "avocado-image-var-qemux86-64.btrfs",
        "initramfs": "avocado-image-initramfs-qemux86-64.cpio.zst",
        "kernel": "bzImage",
        "bootloader": "systemd-bootx64.efi"
      },
      "partitions": [
        { "name": "boot-a", "image": "boot", "partition_type": "EF00", "partition_uuid": "a2e0a8c1-0002-4b01-a000-0000000000a1", "offset": 1, "offset_unit": "mebibytes", "size": 256, "size_unit": "mebibytes" },
        { "name": "boot-b", "partition_type": "EF00", "partition_uuid": "a2e0a8c1-0002-4b01-b000-0000000000b1", "size": 256, "size_unit": "mebibytes" },
        { "name": "recovery", "partition_type": "EF00", "size": 256, "size_unit": "mebibytes" },
        { "name": "rootfs-a", "image": "rootfs", "partition_type": "8304", "size": 512, "size_unit": "mebibytes" },
        { "name": "rootfs-b", "partition_type": "8304", "size": 512, "size_unit": "mebibytes" },
        { "name": "var", "image": "var", "partition_type": "8300", "partition_uuid": "4d21b016-b534-45c2-a9fb-5c16e091fd2d", "size": 512, "size_unit": "mebibytes", "expand": "true" }
      ]
    }
  }
}
