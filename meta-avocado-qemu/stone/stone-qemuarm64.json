{
  "runtime": {
    "platform": "avocado-qemuarm64",
    "architecture": "arm64"
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-qemuarm64-rootdisk.zip",
      "build": "fwup",
      "build_args": {
        "template": "rootdisk.conf"
      },
      "devpath": "/dev/mmcblk0",
      "block_size": 512,
      "images": {
        "boot": {
          "out": "boot.img",
          "size": 128,
          "size_unit": "mebibytes",
          "build_args": {
            "type": "fat",
            "variant": "FAT32"
          },
          "files": [
            "avocado-image-initramfs-avocado-qemuarm64.cpio.zst",
            "Image"
          ]
        },
        "rootfs": "avocado-image-rootfs-avocado-qemuarm64.rootfs.squashfs",
        "var": "avocado-image-var-avocado-qemuarm64.var.img"
      },
      "partitions": [
        {
          "image": "boot",
          "offset": 1028,
          "offset_unit": "bytes",
          "size": 128,
          "size_unit": "mebibytes"
        },
        {
          "image": "rootfs",
          "size": 160,
          "size_unit": "mebibytes"
        },
        {
          "image": "var",
          "expand": "true"
        }
      ]
    }
  }
}
