{
  "runtime": {
    "platform": "avocado-qemuarm64",
    "architecture": "arm64",
    "provision": "stone-provision.sh"
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-qemuarm64-rootdisk.zip",
      "build_args": {
        "type": "fwup",
        "template": "rootdisk.conf"
      },
      "devpath": "/dev/mmcblk0",
      "block_size": 512,
      "uuid": "4bc367b3-5d70-4289-b24d-9b09cb79685c",
      "images": {
        "bios": "flash.bin",
        "uboot_env": "uboot.env",
        "boot": {
          "out": "boot.img",
          "size": 128,
          "size_unit": "mebibytes",
          "build_args": {
            "type": "fat",
            "variant": "FAT32",
            "files": [
              "avocado-image-initramfs-avocado-qemuarm64.cpio.zst",
              "Image"
            ]
          }
        },
        "rootfs": "avocado-image-rootfs-avocado-qemuarm64.rootfs.squashfs",
        "var": "avocado-image-var-avocado-qemuarm64.var.img"
      },
      "partitions": [
        {
          "name": "uboot-env",
          "image": "uboot_env",
          "offset": 1,
          "offset_unit": "mebibytes",
          "offset_redundant": 1152,
          "offset_redundant_unit": "kibibytes",
          "size": 128,
          "size_unit": "kibibytes"
        },
        {
          "name": "boot-a",
          "image": "boot",
          "offset": 2,
          "offset_unit": "mebibytes",
          "size": 128,
          "size_unit": "mebibytes"
        },
        {
          "name": "boot-b",
          "image": "",
          "size": 128,
          "size_unit": "mebibytes"
        },
        {
          "name": "recovery",
          "image": "",
          "size": 128,
          "size_unit": "mebibytes"
        },
        {
          "name": "rootfs-a",
          "image": "rootfs",
          "size": 160,
          "size_unit": "mebibytes"
        },
        {
          "name": "rootfs-b",
          "image": "",
          "size": 160,
          "size_unit": "mebibytes"
        },
        {
          "name": "var",
          "image": "var",
          "size": 128,
          "size_unit": "mebibytes",
          "expand": "true"
        }
      ]
    }
  }
}
