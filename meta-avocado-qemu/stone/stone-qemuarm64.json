{
  "runtime": {
    "platform": "avocado-qemuarm64",
    "architecture": "arm64",
    "provision_default": "img"
  },
  "provision": {
    "envs": {
      "device_info": {
        "AVOCADO_DEVICE_CERT": "${AVOCADO_DEVICE_CERT}",
        "AVOCADO_DEVICE_KEY": "${AVOCADO_DEVICE_KEY}",
        "AVOCADO_DEVICE_ID": "${AVOCADO_DEVICE_ID}"
      },
      "peridio": {
        "PERIDIO_VERSION": "${PERIDIO_VERSION}"
      },
      "cmdline": {
        "AVOCADO_CMDLINE_EXTRA": "${AVOCADO_CMDLINE_EXTRA}"
      }
    },
    "profiles": {
      "img": {
        "script": "stone-provision-img.sh",
        "envs": ["device_info", "peridio", "cmdline"]
      },
      "peridio": {
        "script": "stone-provision-peridio.sh",
        "envs": ["peridio"]
      }
    }
  },
  "storage_devices": {
    "rootdisk": {
      "out": "avocado-os-qemuarm64.zip",
      "build_args": {
        "type": "fwup",
        "template": "rootdisk.conf"
      },
      "devpath": "/dev/mmcblk0",
      "block_size": 512,
      "uuid": "4bc367b3-5d70-4289-b24d-9b09cb79685c",
      "images": {
        "bios": "flash.bin",
        "uboot_env": "uboot.env",
        "boot": {
          "out": "boot.img",
          "size": 64,
          "size_unit": "mebibytes",
          "build_args": {
            "type": "fat",
            "variant": "FAT32",
            "files": ["avocado-image-initramfs-qemuarm64.cpio.zst", "Image"]
          }
        },
        "rootfs": "avocado-image-rootfs-qemuarm64.erofs-lz4",
        "var": "avocado-image-var-qemuarm64.btrfs"
      },
      "partitions": [
        {
          "name": "uboot-env",
          "image": "uboot_env",
          "offset": 1,
          "offset_unit": "mebibytes",
          "offset_redundant": 1280,
          "offset_redundant_unit": "kibibytes",
          "size": 128,
          "size_unit": "kibibytes"
        },
        {
          "name": "boot-a",
          "image": "boot",
          "offset": 2,
          "offset_unit": "mebibytes",
          "size": 64,
          "size_unit": "mebibytes"
        },
        {
          "name": "boot-b",
          "image": "",
          "size": 64,
          "size_unit": "mebibytes"
        },
        {
          "name": "recovery",
          "image": "",
          "size": 64,
          "size_unit": "mebibytes"
        },
        {
          "name": "rootfs-a",
          "image": "rootfs",
          "size": 128,
          "size_unit": "mebibytes"
        },
        {
          "name": "rootfs-b",
          "image": "",
          "size": 128,
          "size_unit": "mebibytes"
        },
        {
          "name": "var",
          "image": "var",
          "size": 512,
          "size_unit": "mebibytes",
          "expand": "true"
        }
      ]
    }
  }
}
